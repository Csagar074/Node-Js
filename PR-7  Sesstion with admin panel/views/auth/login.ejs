<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login Page</title>

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .auth-box {
      width: 100%;
      max-width: 420px;
      background: white;
      border-radius: 20px;
      padding: 30px;
      color: #333;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
      animation: fadeIn 1s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo {
      text-align: center;
      margin-bottom: 25px;
    }

    .logo img {
      width: 90px;
    }

    .form-control {
      background: #f5f5f5;
      border: 1px solid #ddd;
      color: #333;
      height: 48px;
      border-radius: 12px;
    }

    .form-control::placeholder {
      color: #999;
    }

    .form-control:focus {
      background: white;
      border-color: #667eea;
      box-shadow: none;
      color: #333;
    }

    .btn-main {
      width: 100%;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #ff512f, #dd2476);
      border: none;
      color: white;
      font-weight: 600;
      transition: 0.3s;
    }

    .btn-main:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }

    .link-btn {
      color: #667eea;
      font-size: 14px;
      cursor: pointer;
      display: inline-block;
      margin-top: 10px;
    }

    .link-btn:hover {
      text-decoration: underline;
    }

    #recoverform {
      display: none;
    }

    h4 {
      text-align: center;
      margin-bottom: 20px;
      font-weight: 600;
    }
  </style>
</head>

<body>

  <div class="auth-box">
    <!-- LOGIN FORM -->
    <div id="loginform">
      <div class="logo">
        <img src="https://cdn-icons-png.flaticon.com/512/5087/5087579.png" alt="logo">
      </div>

      <h4>Welcome Back</h4>

      <form method="post" action="/login">
        <div class="form-group">
          <input type="email" class="form-control" name="email" placeholder="Enter Email" required>
        </div>

        <div class="form-group">
          <input type="password" class="form-control" name="password" placeholder="Enter Password" required>
        </div>

        <button type="submit" class="btn-main">Login</button>

        <div class="text-center">
          <span class="link-btn" id="to-recover">Forgot Password?</span>
        </div>
      </form>
    </div>

    <!-- RECOVER FORM -->
    <div id="recoverform">
      <div class="logo">
        <img src="https://cdn-icons-png.flaticon.com/512/1828/1828919.png" alt="recover">
      </div>

      <h4>Recover Password</h4>

      <form method="post" action="/verify-email">
        <div class="form-group">
          <input type="email" class="form-control" name="email" placeholder="Enter Your Email" required>
        </div>

        <button type="submit" class="btn-main">Recover</button>

        <div class="text-center">
          <span class="link-btn" id="to-login">Back to Login</span>
        </div>
      </form>
    </div>
  </div>

  <!-- JS -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <script>
    $('#to-recover').click(function () {
      $('#loginform').slideUp();
      $('#recoverform').fadeIn();
    });

    $('#to-login').click(function () {
      $('#recoverform').hide();
      $('#loginform').fadeIn();
    });
  </script>

</body>
</html>
