<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Customer — Interactive UI</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;}

body{
    font-family: Inter,Segoe UI,Arial;
    background: linear-gradient(120deg,#eef2f7,#dfe3eb);
    min-height:100vh;
    padding:40px 20px;
}

/* Page Title */
.page-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}
.page-head h1{
    font-weight:700;
    font-size:24px;
}
.page-head a{
    text-decoration:none;
    color:#0a66c2;
    font-weight:600;
}

/* Interactive Card */
.form-card{
    background:#fff;
    border-radius:14px;
    padding:28px;
    box-shadow:0 10px 30px rgba(0,0,0,.1);
    border:1px solid rgba(0,0,0,.05);
    transition:.3s;
}
.form-card:hover{
    transform:translateY(-4px);
}

/* Floating Label Inputs */
.input-group{
    position:relative;
}
.input-group input,
.input-group select{
    height:44px;
    border-radius:10px;
    padding:12px 14px;
    border:1px solid #cfcfcf;
    transition:.25s;
}
.input-group input:focus,
.input-group select:focus{
    border-color:#0a66c2;
    box-shadow:0 0 0 3px rgba(10,102,194,.15);
}
.input-group label{
    position:absolute;
    left:14px;
    top:12px;
    font-size:13px;
    color:#777;
    background:#fff;
    padding:0 4px;
    transition:.25s;
    pointer-events:none;
}
.input-group input:focus + label,
.input-group input:not(:placeholder-shown)+label,
.input-group select:focus+label{
    top:-8px;
    font-size:11px;
    color:#0a66c2;
}

/* Radio Chips */
.radio-chip{
    display:flex;
    gap:8px;
}
.radio-chip input{display:none;}
.radio-chip label{
    border:1px solid #ccc;
    padding:7px 14px;
    border-radius:24px;
    cursor:pointer;
    transition:.25s;
}
.radio-chip input:checked + label{
    background:#0a66c2;
    color:#fff;
    border-color:#0a66c2;
}

/* Upload Preview */
.preview{
    width:90px;
    height:90px;
    border-radius:12px;
    border:2px solid #ddd;
    object-fit:cover;
}

/* Button */
.btn-submit{
    background:#0a66c2;
    border:none;
    padding:12px 20px;
    border-radius:30px;
    font-weight:600;
    width:100%;
    color:#fff;
    transition:.25s;
}
.btn-submit:hover{
    background:#004182;
    transform:translateY(-1px);
}

/* Responsive */
@media(max-width:768px){
    .form-grid{grid-template-columns:1fr;}
}
</style>
</head>

<body>
<div class="container">

<div class="form-card">

<div class="page-head">
    <h1>Edit Customer</h1>
    <a href="/allcusto">← Back to Customer List</a>
</div>

<form action="/updatecusto" method="POST" enctype="multipart/form-data" class="mt-3">

<input type="hidden" name="id" value="<%= edit.id %>">

<div class="row g-3">
<!-- customer Name  -->
<div class="col-md-6">
<div class="input-group">
<input type="text" name="Customer_Name" value="<%= edit.Customer_Name %>" placeholder=" " required>
<label>Name</label>
</div>
</div>
<!-- phone Number  -->
<div class="col-md-6">
<div class="input-group">
<input type="text" name="Mobile_Number" value="<%= edit.Mobile_Number %>" placeholder=" " required>
<label>Mobile Number</label>
</div>
</div>
<!-- email  -->
<div class="col-md-6">
<div class="input-group">
<input type="email" name="customer_Email" value="<%= edit.customer_Email %>" placeholder=" " required>
<label>Email</label>
</div>
</div>
<!-- password  -->
<div class="col-md-6">
<div class="input-group">
<input type="password" name="customer_Password" value="<%= edit.customer_Password %>" placeholder=" " required>
<label>Password</label>
</div>
</div>
<!-- order items  -->
<!-- <div class="col-md-6">
<div class="input-group">
<input type="text" name="Order_Items" value="<%= edit.Order_Items %>" placeholder=" " required>
<label>Order Items</label>
</div>
</div> -->
<!-- price  -->
<div class="col-md-6">
<div class="input-group">
<input type="number" name="Price" value="<%= edit.Price %>" placeholder=" " required>
<label>Price</label>
</div>
</div>

<!-- Payment Method -->
<div class="col-md-12">
<p style="font-weight:600;margin-bottom:6px;">Payment Method</p>
<div class="radio-chip">
    <input type="radio" id="cash" name="Payment_Method" value="Cash" <%= edit.Payment_Method==='Cash' ? 'checked' : '' %>>
    <label for="cash">Cash</label>

    <input type="radio" id="upi" name="Payment_Method" value="UPI" <%= edit.Payment_Method==='UPI' ? 'checked' : '' %>>
    <label for="upi">UPI</label>

    <input type="radio" id="card" name="Payment_Method" value="Card" <%= edit.Payment_Method==='Card' ? 'checked' : '' %>>
    <label for="card">Card</label>
</div>
</div>

<!-- Order Dropdown -->
<div class="col-md-6">
<div class="input-group">
<select name="Order" required>
<% ["Dosa","Panirtikka","Mansuriyam","Kajukali"].map(o=>{ %>
<option value="<%= o %>" <%= edit.Order===o?'selected':'' %>><%= o %></option>
<% }) %>
</select>
<label>Order</label>
</div>
</div>

<!-- Image Upload -->
<div class="col-md-6">
<p style="font-weight:600;">Order Profile</p>
<img src="/<%= edit.order_ProfilePic %>" class="preview mb-2">
<input type="file" name="order_ProfilePic" class="form-control">
</div>

<div class="col-12 mt-2">
<button class="btn-submit">Update Customer</button>
</div>

</div>
</form>
</div>
</div>

</body>
</html>
