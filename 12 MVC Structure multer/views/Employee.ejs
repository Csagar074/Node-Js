<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Form - LinkedIn Style</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../dist/style.css">
</head>

<body>

    <div class="container">
        <div class="form-card">
            <div style="display: flex; justify-content: space-between;">
                <h1 style="margin: 0px;">Employee Information</h1>
                <a href="/form/allEmp" style="text-decoration: none; display: inline-block; color: rgb(0, 0, 59);">Go
                    To All
                    Employee Page
                    →</a>
            </div>
            <p class="subtitle">Please fill in your details below</p>

            <form id="employeeForm" action="/form/addEmp" method="POST" enctype="multipart/form-data">
                <div class="form-grid">
                    <div>
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="emp_Name" placeholder="Enter your full name"
                            required>
                    </div>

                    <div>
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="emp_Email" placeholder="you@example.com"
                            required>
                    </div>

                    <div>
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" name="emp_Password" placeholder="Create a password"
                            required>
                    </div>

                    <div>
                        <label class="form-label">Salary</label>
                        <input type="number" class="form-control" name="emp_Salary" placeholder="Enter salary" required>
                    </div>

                    <div>
                        <label class="form-label">Gender</label>
                        <div class="gender-group">
                            <div class="form-check">
                                <input class="form-check-input" name="emp_gender" type="radio" name="gender"
                                    value="male">
                                <label class="form-check-label">Male</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" name="emp_gender" type="radio" name="gender"
                                    value="female">
                                <label class="form-check-label">Female</label>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label">Role</label>
                        <select class="form-select" name="emp_Role" required>
                            <% ["Owner" , "Manager" , "Employee" , "Intern" ].map((role)=> { %>
                                <option value="<%= role %>">
                                    <%= role %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="form-group-full">
                        <label class="form-label">Hobby's</label>
                        <div class="checkbox-grid">
                            <% ["Reading" , "Sports" , "Coding" , "Scrolling" ].map((skill)=> { %>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="<%= skill %>"
                                        id="<%= skill.toLowerCase() %>" name="emp_Hobbys">
                                    <label class="form-check-label" for="<%= skill.toLowerCase() %>">
                                        <%= skill %>
                                    </label>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <div class="form-group-full">
                        <label class="form-label">Profile Picture</label>
                        <input type="file" class="form-control" name="emp_ProfilePic" required>
                    </div>

                    <div class="form-group-full">
                        <button type="submit" class="btn btn-primary">Submit Application</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>