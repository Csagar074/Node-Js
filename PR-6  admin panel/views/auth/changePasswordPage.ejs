<%- include('../header') %>

<style>
    body {
        background: linear-gradient(to right, #4facfe, #00f2fe);
    }

    .page-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .password-card {
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(to right, #667eea, #764ba2);
        color: white;
        padding: 20px;
        text-align: center;
    }

    .card-header-custom h4 {
        margin: 0;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .form-control {
        border-radius: 30px;
        padding: 12px 20px;
    }

    .btn-custom {
        width: 100%;
        border-radius: 30px;
        padding: 12px;
        font-weight: 600;
        letter-spacing: 1px;
        background: linear-gradient(to right, #667eea, #764ba2);
        border: none;
        color: white;
        transition: 0.3s ease;
    }

    .btn-custom:hover {
        transform: scale(1.03);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .form-group label {
        font-weight: 600;
    }
</style>

<!-- Page wrapper -->
<div class="page-wrapper">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card password-card">

                    <!-- Card Header -->
                    <div class="card-header-custom">
                        <h4>🔐 Change Password</h4>
                       
                    </div>

                    <!-- Form -->
                    <form class="form-horizontal" method="post" action="/change-password">
                        <div class="card-body">

                            <!-- Current Password -->
                            <div class="form-group">
                                <label>Current Password</label>
                                <input type="password" class="form-control" name="current_psw"
                                    placeholder="Enter Current Password">
                            </div>

                            <!-- New Password -->
                            <div class="form-group">
                                <label>New Password</label>
                                <input type="password" class="form-control" name="new_psw"
                                    placeholder="Enter New Password">
                            </div>

                            <!-- Confirm Password -->
                            <div class="form-group">
                                <label>Confirm Password</label>
                                <input type="password" class="form-control" name="conform_psw"
                                    placeholder="Confirm New Password">
                            </div>
                        </div>

                        <!-- Button -->
                        <div class="card-body">
                            <button type="submit" class="btn btn-custom">
                                🔄 Change Password
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../footer') %>
