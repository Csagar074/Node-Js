            <style>
                @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Epilogue:wght@300;400;500&display=swap');

                :root {
                    --c-bg: #050810;
                    --c-surface: #0c1120;
                    --c-card: #101828;
                    --c-border: rgba(255, 255, 255, 0.07);
                    --c-border2: rgba(255, 255, 255, 0.13);
                    --c-text: #e2e8f5;
                    --c-muted: #5a6a8a;
                    --c-dim: #2a3450;
                    --c-blue: #2563ff;
                    --c-blue-g: rgba(37, 99, 255, 0.18);
                    --c-teal: #00d4aa;
                    --c-teal-g: rgba(0, 212, 170, 0.13);
                    --c-violet: #9333ea;
                    --c-violet-g: rgba(147, 51, 234, 0.15);
                    --c-amber: #f59e0b;
                    --c-amber-g: rgba(245, 158, 11, 0.13);
                    --c-rose: #fb7185;
                    --c-rose-g: rgba(251, 113, 133, 0.13);
                }

                .dv-wrapper {
                    font-family: 'Epilogue', sans-serif;
                    background: var(--c-bg);
                    min-height: 100vh;
                    padding: 10px 32px 60px;
                    position: relative;
                    overflow: hidden;
                }

                /* ambient glow orbs behind everything */
                .dv-wrapper::before,
                .dv-wrapper::after {
                    content: '';
                    position: fixed;
                    border-radius: 50%;
                    filter: blur(110px);
                    pointer-events: none;
                    z-index: 0;
                }

                .dv-wrapper::before {
                    width: 520px;
                    height: 520px;
                    top: -160px;
                    left: -120px;
                    background: radial-gradient(circle, rgba(37, 99, 255, 0.1) 0%, transparent 70%);
                }

                .dv-wrapper::after {
                    width: 420px;
                    height: 420px;
                    bottom: -100px;
                    right: -80px;
                    background: radial-gradient(circle, rgba(147, 51, 234, 0.09) 0%, transparent 70%);
                }

                .dv-inner {
                    position: relative;
                    z-index: 1;
                    max-width: 1280px;
                    margin: 0 auto;
                }

                /* ── PAGE TITLE ── */
                .dv-page-title {
                    font-family: 'Syne', sans-serif;
                    font-size: 28px;
                    font-weight: 800;
                    color: var(--c-text);
                    letter-spacing: -0.8px;
                    margin-bottom: 28px;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                .dv-page-title .title-dot {
                    width: 8px;
                    height: 8px;
                    background: var(--c-blue);
                    border-radius: 50%;
                    box-shadow: 0 0 12px var(--c-blue);
                    display: inline-block;
                }

                /* ── WELCOME BANNER ── */
                .dv-welcome {
                    position: relative;
                    border-radius: 20px;
                    padding: 36px 40px;
                    margin-bottom: 32px;
                    overflow: hidden;
                    background: var(--c-card);
                    border: 1px solid var(--c-border2);
                }

                .dv-welcome-noise {
                    position: absolute;
                    inset: 0;
                    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.035'/%3E%3C/svg%3E");
                    pointer-events: none;
                }

                .dv-welcome-glow {
                    position: absolute;
                    top: -60px;
                    right: -40px;
                    width: 320px;
                    height: 320px;
                    background: radial-gradient(circle, rgba(37, 99, 255, 0.15) 0%, transparent 65%);
                    pointer-events: none;
                }

                .dv-welcome-glow2 {
                    position: absolute;
                    bottom: -40px;
                    left: 30%;
                    width: 240px;
                    height: 240px;
                    background: radial-gradient(circle, rgba(0, 212, 170, 0.08) 0%, transparent 65%);
                    pointer-events: none;
                }

                .dv-welcome-content {
                    position: relative;
                    z-index: 1;
                }

                .dv-welcome-eyebrow {
                    font-size: 11px;
                    font-weight: 500;
                    letter-spacing: 2.5px;
                    text-transform: uppercase;
                    color: var(--c-blue);
                    margin-bottom: 10px;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                .dv-welcome-eyebrow::before {
                    content: '';
                    width: 24px;
                    height: 1.5px;
                    background: var(--c-blue);
                    display: inline-block;
                }

                .dv-welcome h2 {
                    font-family: 'Syne', sans-serif;
                    font-size: 32px;
                    font-weight: 800;
                    color: var(--c-text);
                    letter-spacing: -1px;
                    line-height: 1.2;
                    margin: 0 0 8px;
                }

                .dv-welcome h2 .name-highlight {
                    background: linear-gradient(90deg, #60a5fa, var(--c-teal));
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                .dv-welcome p {
                    font-size: 14px;
                    color: var(--c-muted);
                    margin: 0;
                }

                .dv-welcome-badge {
                    position: absolute;
                    right: 40px;
                    top: 50%;
                    transform: translateY(-50%);
                    display: flex;
                    flex-direction: column;
                    align-items: flex-end;
                    gap: 10px;
                }

                .dv-pill {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    padding: 7px 14px;
                    border-radius: 40px;
                    font-size: 12px;
                    font-weight: 600;
                    border: 1px solid;
                }

                .dv-pill-teal {
                    background: var(--c-teal-g);
                    color: var(--c-teal);
                    border-color: rgba(0, 212, 170, 0.25);
                }

                .dv-pill-blue {
                    background: var(--c-blue-g);
                    color: #60a5ff;
                    border-color: rgba(37, 99, 255, 0.3);
                }

                .dv-pill .pulse-dot {
                    width: 6px;
                    height: 6px;
                    background: currentColor;
                    border-radius: 50%;
                    animation: pulse-ring 2s infinite;
                }

                @keyframes pulse-ring {

                    0%,
                    100% {
                        opacity: 1;
                        transform: scale(1);
                    }

                    50% {
                        opacity: 0.5;
                        transform: scale(1.4);
                    }
                }

                /* ── STATS GRID ── */
                .dv-stats-grid {
                    display: grid;
                    grid-template-columns: repeat(5, 1fr);
                    gap: 16px;
                    margin-bottom: 0;
                }

                /* card base */
                .dv-stat {
                    background: var(--c-card);
                    border: 1px solid var(--c-border);
                    border-radius: 18px;
                    padding: 24px;
                    position: relative;
                    overflow: hidden;
                    cursor: default;
                    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                        border-color 0.25s,
                        box-shadow 0.25s;
                    animation: stat-in 0.55s ease both;
                }

                @keyframes stat-in {
                    from {
                        opacity: 0;
                        transform: translateY(24px) scale(0.96);
                    }

                    to {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                    }
                }

                .dv-stat:nth-child(1) {
                    animation-delay: 0.06s;
                }

                .dv-stat:nth-child(2) {
                    animation-delay: 0.12s;
                }

                .dv-stat:nth-child(3) {
                    animation-delay: 0.18s;
                }

                .dv-stat:nth-child(4) {
                    animation-delay: 0.24s;
                }

                .dv-stat:nth-child(5) {
                    animation-delay: 0.30s;
                }

                .dv-stat:hover {
                    transform: translateY(-6px) scale(1.01);
                    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.45);
                }

                /* color accents per card */
                .dv-stat[data-accent="blue"] {
                    --acc: var(--c-blue);
                    --acc-g: var(--c-blue-g);
                }

                .dv-stat[data-accent="teal"] {
                    --acc: var(--c-teal);
                    --acc-g: var(--c-teal-g);
                }

                .dv-stat[data-accent="violet"] {
                    --acc: var(--c-violet);
                    --acc-g: var(--c-violet-g);
                }

                .dv-stat[data-accent="amber"] {
                    --acc: var(--c-amber);
                    --acc-g: var(--c-amber-g);
                }

                .dv-stat[data-accent="rose"] {
                    --acc: var(--c-rose);
                    --acc-g: var(--c-rose-g);
                }

                .dv-stat:hover {
                    border-color: color-mix(in srgb, var(--acc) 40%, transparent);
                }

                /* top-right glow splash */
                .dv-stat::before {
                    content: '';
                    position: absolute;
                    top: -30px;
                    right: -30px;
                    width: 120px;
                    height: 120px;
                    background: radial-gradient(circle, var(--acc-g) 0%, transparent 70%);
                    pointer-events: none;
                    transition: opacity 0.25s;
                    opacity: 0.7;
                }

                .dv-stat:hover::before {
                    opacity: 1;
                }

                /* bottom decorative bar */
                .dv-stat::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 2px;
                    background: linear-gradient(90deg, transparent, var(--acc), transparent);
                    opacity: 0;
                    transition: opacity 0.25s;
                }

                .dv-stat:hover::after {
                    opacity: 1;
                }

                .dv-stat-top {
                    display: flex;
                    align-items: flex-start;
                    justify-content: space-between;
                    margin-bottom: 20px;
                }

                .dv-stat-icon {
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    background: var(--acc-g);
                    border: 1px solid color-mix(in srgb, var(--acc) 30%, transparent);
                    display: grid;
                    place-items: center;
                    font-size: 18px;
                    position: relative;
                    z-index: 1;
                }

                .dv-stat-trend {
                    font-size: 11px;
                    font-weight: 700;
                    padding: 4px 9px;
                    border-radius: 8px;
                    background: var(--acc-g);
                    color: var(--acc);
                    letter-spacing: 0.3px;
                }

                .dv-stat-value {
                    font-family: 'Syne', sans-serif;
                    font-size: 38px;
                    font-weight: 800;
                    color: var(--c-text);
                    letter-spacing: -2px;
                    line-height: 1;
                    margin-bottom: 6px;
                    position: relative;
                    z-index: 1;
                }

                .dv-stat-label {
                    font-size: 12px;
                    font-weight: 500;
                    color: var(--c-muted);
                    letter-spacing: 0.3px;
                    text-transform: uppercase;
                    position: relative;
                    z-index: 1;
                }

                /* sparkline — pure CSS decorative line */
                .dv-sparkline {
                    margin-top: 16px;
                    height: 32px;
                    position: relative;
                    overflow: hidden;
                }

                .dv-sparkline svg {
                    width: 100%;
                    height: 100%;
                    overflow: visible;
                }

                .dv-sparkline polyline {
                    fill: none;
                    stroke: var(--acc);
                    stroke-width: 1.5;
                    opacity: 0.5;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }
            </style>

            <!-- ════════════════════════════════════ -->
