<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clean Library Collection</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   <link rel="stylesheet" href="../dist/style.css">
</head>

<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-book-reader me-2"></i>Clean Library
            </a>
            <div class="d-flex">
                <div class="view-toggle">
                    <span class="me-2 text-light">View:</span>
                    <button class="view-btn active" id="cardViewBtn">
                        <i class="fas fa-th-large"></i> Cards
                    </button>
                    <button class="view-btn" id="tableViewBtn">
                        <i class="fas fa-table"></i> Table
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <h1 class="header-title">All Book Collection</h1>

    <div class="container">
        <!-- Card View -->
        <div id="cardView" class="row">
            <% if (allbook.length> 0) { %>
                <% allbook.forEach((book, index)=> { %>
                    <div class="col-card col-lg-2-4 col-md-4 col-sm-6 col-xs-6">
                        <div class="book-card">
                            <div class="book-img-container">
                                <img src="<%= book.BookImg %>" alt="<%= book.BookName %>" class="book-img">
                            </div>
                            <div class="book-card-body">
                                <h5 class="book-title">
                                    <%= book.BookName %>
                                </h5>
                                <p class="book-author"><i class="fas fa-user-edit me-1"></i>
                                    <%= book.BookAuth %>
                                </p>

                                <div class="book-meta">
                                    <div class="book-price">$<%= book.BookPrice %>
                                    </div>
                                    <div class="book-language">
                                        <%= book.BookLang %>
                                    </div>
                                </div>

                                <div class="action-buttons">
                                    <button class="btn btn-action btn-delete">
                                        <a href="/bookDelete?BookId=<%= book.id %>"
                                            class="text-white text-decoration-none">
                                            <i class="fas fa-trash-alt me-1"></i> Delete
                                        </a>
                                    </button>
                                    <button class="btn btn-action btn-edit">
                                        <a href="/bookEdit/<%= book.id %>" class="text-white text-decoration-none">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="col-12">
                                <div class="empty-state">
                                    <i class="fas fa-book-open"></i>
                                    <h3>No Books Found</h3>
                                    <p>Your library collection is empty. Add your first book to get started.</p>
                                </div>
                            </div>
                            <% } %>
        </div>

        <!-- Table View (Hidden by default) -->
        <div id="tableView" class="table-view">
            <% if (allbook.length> 0) { %>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Book Name</th>
                            <th scope="col">Author</th>
                            <th scope="col">Price</th>
                            <th scope="col">Language</th>
                            <th scope="col">Cover</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% allbook.forEach((book, index)=> { %>
                            <tr>
                                <th scope="row">
                                    <%= index + 1 %>
                                </th>
                                <td>
                                    <%= book.BookName %>
                                </td>
                                <td>
                                    <%= book.BookAuth %>
                                </td>
                                <td>$<%= book.BookPrice %>
                                </td>
                                <td>
                                    <%= book.BookLang %>
                                </td>
                                <td><img src="<%= book.BookImg %>" alt="" width="50" class="rounded"></td>
                                <td>
                                    <button class="btn btn-sm btn-danger me-1">
                                        <a href="/bookDelete?BookId=<%= book.id %>"
                                            class="text-white text-decoration-none">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </button>
                                    <button class="btn btn-sm btn-primary">
                                        <a href="/bookEdit/<%= book.id %>" class="text-white text-decoration-none">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
                <% } %>
        </div>

        <!-- Footer Buttons -->
        <div class="footer-buttons">
            <a href="/AddBookPage" class="btn-add-book">
                <i class="fas fa-plus-circle me-2"></i> Add New Book
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // View toggle functionality
        document.addEventListener('DOMContentLoaded', function () {
            const cardViewBtn = document.getElementById('cardViewBtn');
            const tableViewBtn = document.getElementById('tableViewBtn');
            const cardView = document.getElementById('cardView');
            const tableView = document.getElementById('tableView');

            // Set initial view (card view)
            cardViewBtn.classList.add('active');
            cardView.style.display = 'flex';
            tableView.style.display = 'none';

            // Card view button click
            cardViewBtn.addEventListener('click', function () {
                cardViewBtn.classList.add('active');
                tableViewBtn.classList.remove('active');
                cardView.style.display = 'flex';
                tableView.style.display = 'none';
            });

            // Table view button click
            tableViewBtn.addEventListener('click', function () {
                tableViewBtn.classList.add('active');
                cardViewBtn.classList.remove('active');
                tableView.style.display = 'block';
                cardView.style.display = 'none';
            });
        });
    </script>
</body>

</html>