<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Table</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Employee Records</h2>
            <a href="/emp" class="btn btn-primary btn-lg">+ Add Employee</a>
        </div>

        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body">

                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>No</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Password</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Salary</th>
                            <th>Hobby</th>
                            <th>Role</th>
                            <th colspan="2">Action</th>
                        </tr>
                    </thead>

                    <tbody class="text-center">
                        <% allEmp.map((emp, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= emp.emp_name %></td>
                            <td><%= emp.emp_email %></td>
                            <td><%= emp.emp_password %></td>
                            <td><%= emp.emp_phone %></td>
                            <td><%= emp.emp_gender %></td>
                            <td>₹ <%= emp.emp_salary %></td>
                            <td><%= emp.emp_hobby %></td>
                            <td><%= emp.emp_role %></td>

                            <td>
                                <a href="/emp/edit/<%= emp._id %>" class="btn btn-warning btn-sm rounded-pill px-3">
                                    Edit
                                </a>
                            </td>
                            <td>
                                <a href="/emp/delete/<%= emp._id %>" class="btn btn-danger btn-sm rounded-pill px-3">
                                    Delete
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
