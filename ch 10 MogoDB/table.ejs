<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Table View</title>
</head>
<body>
    <table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">Book Name</th>
      <th scope="col">Book Author</th>
      <th scope="col">Book Price</th>
      <th scope="col">Book Language</th>
       <th scope="col">Edit</th>
        <th scope="col">Delete</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">1</th>
      <td>I have a dream.</td>
      <td>Martin Luther King <td>
      <td>109</td>
       <td>Hindi</td>
    </tr>
    <tr>
      <th scope="row">2</th>
      <td>Life is like riding a bicycle</td>
      <td>Albert Einstein <td>
      <td>205</td>
      <td>Engilsh</td>
    </tr>
     <tr>
      <th scope="row">3</th>
      <td>The purpose of our lives is to be happy</td>
      <td>Dalai Lama <td>
      <td>365</td>
      <td>Gujarati</td>
    </tr>
     <tr>
      <th scope="row">4</th>
      <td>The future depends on what you do today.</td>
      <td>Mahatma Gandhi<td>
      <td>450</td>
      <td>Hindi</td>
    </tr>
  </tbody>
  <% allbooks.map(Book,index)=>{
    <tr>
        <th scope="row">
            <%=index +1 %>
        </th>
        <th scope="row">
            <% Books.book_name %>
        </th>
        <th scope="row">
          <%=Books.book_author %>
        </th>
        <th scope="row">
          <%=Books.book_price %>
        </th>
        <th scope="row">
          <%= Books.book_lang %>
        </th>

          <div>
                <a href="/editUser?id=<%= user.id %>" class="btn-edit me-2">Edit</a>
                <a href="/deleteBook?id=<%= user.id %>" class="btn-delete">Delete</a>
            </div>

        </div>
        <% }) %>

        <div class="text-center mt-5">
            <a href="/addBook" class="add-btn">Add Book</a>
        </div>
    
    </tr>
    %>
  

</table>

</body>
</html>