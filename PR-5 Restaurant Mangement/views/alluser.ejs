<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restorant Recode Table</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Employee Records</h2>
            <a href="/" class="btn btn-primary btn-lg">+ Add Employee</a>
        </div>

        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body">

                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Resto Name</th>
                            <th>Owener Name</th>
                            <th>Resto_email</th>
                            <th>Resto password</th>
                            <th>Resto_address</th>
                            <th>FoodItemName</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>availabilityStatus</th>
                            <th>Cription</th>
                            <th colspan="2">Action</th>
                        </tr>
                    </thead>

                    <tbody class="text-center">
                        <% allresto.map((resto, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= resto.resto_name %></td>
                            <td><%= resto.resto_owener %></td>
                            <td><%= resto.resto_email %></td>
                            <td><%= resto.resto_password %></td>
                            <td><%= resto.contact_number %></td>
                            <td><%= resto.resto_address %></td>
                            <td><%= resto.foodItemName %></td>
                            <td><%= resto.category %></td>
                             <td>₹ <%= resto.price %></td>
                             <td><%= resto.availabilityStatus %></td>
                            <td><%= resto.description %></td>

                            <td>
                                <a href="/resto/editEmp/<%= emp._id %>" class="btn btn-warning btn-sm rounded-pill px-3">
                                    Edit
                                </a>
                            </td>
                            <td>
                                <a href="/emp/deleteEmp/?empId=<%= emp['id'] %>" class="btn btn-danger btn-sm rounded-pill px-3">
                                    Delete
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
