<%- include('../header') %>

<style>
    /* Background matching your image theme */
    .page-wrapper {
        background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
        min-height: 100vh;
        padding-bottom: 50px;
    }

    /* Glassmorphism Card Style - Adjusted for Left Alignment */
    .el-card-item {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 20px !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        padding: 30px !important;
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* Left side alignment */
    }

    /* Checkbox Style Image (Square with slight round corners) */
    .el-card-avatar {
        margin-bottom: 20px;
        align-self: flex-start;
    }

    .el-card-avatar img {
        width: 110px !important;
        height: 110px !important;
        /* object-fit: cover; */
        /* border-radius: 12px !important; */
        /* border: 2px solid rgba(255, 255, 255, 0.4); */
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    .page-title {
        color: #ffffff !important;
        font-weight: 700;
    }

    .el-card-content {
        /* padding: 0 !important; */
        width: 100%;
        text-align: left;
        color: white;
    }

    .el-card-content h4 {
        color: #fff !important;
        font-weight: bold;
        font-size: 26px;
        margin-bottom: 20px;
        text-align: left;
    }

    /* Data Row Styling - Box hata diya, clean list style */
    .text-muted {
        color: rgba(255, 255, 255, 0.9) !important;
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        font-size: 15px;
        background: transparent !important; /* Box background hata diya */
        padding: 5px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05); /* Halka divider for clarity */
    }

    .text-muted i {
        color: #ff4b2b !important; 
        margin-right: 15px;
        font-size: 20px;
        width: 25px;
    }

    /* Action Button - Matches your Image Theme */
    .btn-info {
        background: linear-gradient(to right, #ff416c, #ff4b2b) !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 12px 30px !important; /* Balanced padding */
        width: auto !important; /* Full width se auto kar diya */
        min-width: 160px;
        font-weight: bold;
        margin-top: 25px !important;
        box-shadow: 0 5px 15px rgba(255, 65, 108, 0.3);
        transition: 0.3s;
    }

    .btn-info:hover {
        transform: scale(1.05);
        filter: brightness(1.1);
    }

    .btn-info a {
        color: white !important;
        text-decoration: none;
    }

    hr {
        display: none; /* Clean look ke liye hr hata diya */
    }
</style>

<div class="page-wrapper">
    <div class="page-breadcrumb">
        <div class="row">
            <div class="col-12">
                <h4 class="page-title">Admin Profile</h4>  
            </div>
        </div>
    </div>
    
    <div class="container-fluid"> 
        <div class="row">
            <div class="col-lg-6 col-md-8"> <div class="card bg-transparent border-0">
                    <div class="el-card-item">
                        <div class="el-card-avatar"> 
                            <img src="/<%= admin.profile_image%>" alt="user" />
                        </div>
                        
                        <div class="el-card-content">
                            <h4><%= admin.fname%> <%= admin.lname%></h4>
                            
                            <span class="text-muted"><i class="mdi mdi-email"></i> <%= admin.email%></span>
                            <span class="text-muted"><i class="mdi mdi-phone"></i> <%= admin.phone%></span>
                            <span class="text-muted"><i class="mdi mdi-gender-transgender"></i> <%= admin.gender%></span>
                            <span class="text-muted"><i class="mdi mdi-heart"></i> <%= admin.Hobby%></span>
                            <span class="text-muted"><i class="mdi mdi-map-marker"></i> <%= admin.city%></span>
                            <span class="text-muted"><i class="mdi mdi-information-outline"></i> <%= admin.about%></span>
                            
                            <button class="btn btn-info">
                                <a href="/editAdmin/<%= admin.id %>">
                                    Edit Profile
                                </a>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../footer") %>