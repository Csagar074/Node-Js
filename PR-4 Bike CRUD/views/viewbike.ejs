<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hero Bike</title>

<link rel="icon" href="/views/images/favicon-img.svg">

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
/* ===== Navbar ===== */
.navbar-nav .nav-link {
  position: relative;
  font-weight: 500;
}
.navbar-nav .nav-link::after {
  content: "";
  position: absolute;
  width: 0;
  height: 3px;
  background: #fff;
  left: 0;
  bottom: 0;
  transition: 0.3s;
}
.navbar-nav .nav-link:hover::after {
  width: 100%;
}

/* ===== Sticky Navbar ===== */
.sticky {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 999;
}

/* ===== Banner ===== */
.banner img {
  height: 85vh;
  object-fit: cover;
}

/* ===== Table ===== */
body {
  background: #f4f6f9;
}
.table thead {
  background: #0d6efd;
  color: white;
}
.card {
  border-radius: 15px;
}
.btn {
  border-radius: 20px;
}
img {
  border-radius: 8px;
}

/* ===== Footer ===== */
.footer {
  background: linear-gradient(180deg, #0b0b0b, #121212);
}
.footer-title {
  font-weight: 700;
  margin-bottom: 15px;
}
.footer-title::after {
  content: "";
  width: 40px;
  height: 3px;
  background: #dc3545;
  display: block;
  margin-top: 6px;
}
.footer-links li {
  margin-bottom: 8px;
  cursor: pointer;
  color: #ccc;
}
.footer-links li:hover {
  color: #fff;
  padding-left: 5px;
}
.footer-bottom-link {
  margin-left: 15px;
  color: #aaa;
  text-decoration: none;
}
.footer-bottom-link:hover {
  color: #fff;
}
</style>
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg bg-primary navbar-dark" id="navbar">
  <div class="container-fluid">

    <a class="navbar-brand fw-bold" href="/">
      <img src="/views/images/hiro-logo.svg" height="40">
    </a>

    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-center" id="menu">
      <ul class="navbar-nav gap-4 text-uppercase">
        <li class="nav-item"><a class="nav-link active" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Premia</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Motorcycles</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Services</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Company</a></li>
      </ul>
    </div>

    <div class="d-flex gap-2">
      <a href="/addBike" class="btn btn-success">➕ Add Bike</a>
      <a href="/" class="btn btn-danger">🚲 All Bikes</a>
    </div>

  </div>
</nav>

<!-- ================= BANNER ================= -->
<section class="banner">
  <img src="/views/images/Banner-image.jpg" class="w-100" alt="Banner">
</section>

<!-- ================= BIKE LIST ================= -->
<div class="container my-5">
  <div class="card shadow p-4">

    <h3 class="text-primary mb-3">🚲 Bike List</h3>

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle text-center">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Brand</th>
            <th>Price</th>
            <th>Color</th>
            <th>Engine</th>
            <th>Launch</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
        <% if (allBikes.length === 0) { %>
          <tr>
            <td colspan="8" class="text-muted">No Bikes Found 🚫</td>
          </tr>
        <% } else { %>
          <% allBikes.forEach(bike => { %>
            <tr>
              <td><img src="<%= bike.bike_image %>" width="80"></td>
              <td><%= bike.bike_name %></td>
              <td><%= bike.bike_brand %></td>
              <td>₹ <%= bike.bike_price %></td>
              <td><span class="badge bg-secondary"><%= bike.bike_color %></span></td>
              <td><%= bike.bike_engine %></td>
              <td><%= bike.bike_launch %></td>
              <td>
                <a href="/editBike/<%= bike._id %>" class="btn btn-warning btn-sm">✏ Edit</a>
                <a href="/deleteBike?bikeId=<%= bike._id %>" class="btn btn-danger btn-sm">🗑 Delete</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<!-- ================= FOOTER ================= -->
<footer class="footer text-white pt-5">
  <div class="container">

    <h2 class="text-center fw-bold mb-4">Electric Scooters Near You</h2>
    <hr class="border-secondary">

    <div class="row mt-4">
      <div class="col-md-3">
        <h5 class="footer-title">ABOUT US</h5>
        <ul class="list-unstyled footer-links">
          <li>Board of Directors</li>
          <li>Leadership Team</li>
          <li>Key Policies</li>
          <li>Sustainability</li>
          <li>Our Reports</li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">MY HERO</h5>
        <ul class="list-unstyled footer-links">
          <li>Blogs</li>
          <li>Owner's Manual</li>
          <li>Two Wheelers Tips</li>
          <li>Hero GoodLife</li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">REACH US</h5>
        <ul class="list-unstyled footer-links">
          <li>Contact Us</li>
          <li>Find a Dealer</li>
          <li>Corporate Enquiry</li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">NEWSROOM</h5>
        <ul class="list-unstyled footer-links">
          <li>Media Kit</li>
          <li>Press Releases</li>
        </ul>
      </div>
    </div>

    <hr class="border-secondary">
    <div class="d-flex justify-content-between py-3">
      <p class="mb-0">© 2025 Hero MotoCorp Ltd.</p>
      <div>
        <a href="#" class="footer-bottom-link">Terms</a>
        <a href="#" class="footer-bottom-link">Privacy</a>
        <a href="#" class="footer-bottom-link">Sitemap</a>
      </div>
    </div>

  </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
window.addEventListener("scroll", () => {
  document.getElementById("navbar").classList.toggle("sticky", window.scrollY > 100);
});
</script>

</body>
</html>
