<%- include('../header') %>

    <style>
        .card {
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

        .page-title {
            font-weight: 700;
            color: #4e73df;
        }

        .card-title {
            font-weight: 600;
            color: #1cc88a;
            margin-bottom: 20px;
        }

        .form-control,
        .custom-select {
            border-radius: 25px;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

        .form-control:focus,
        .custom-select:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }

        .form-group label {
            font-weight: 600;
            color: #5a5c69;
        }

        .custom-control-label {
            cursor: pointer;
        }

        .custom-control-input:checked~.custom-control-label::before {
            background-color: #1cc88a;
            border-color: #1cc88a;
        }

        .submit-btn {
            background: linear-gradient(45deg, #4e73df, #1cc88a);
            border: none;
            border-radius: 30px;
            padding: 10px 30px;
            font-size: 16px;
            color: white;
            transition: all 0.3s ease;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(78, 115, 223, 0.4);
        }

        .custom-file input {
            border-radius: 25px;
            padding: 8px;
        }

        .form-section {
            background: #f8f9fc;
            border-radius: 15px;
            padding: 20px;
        }
    </style>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Add Admin </h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Create Admin</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <form class="form-horizontal" method="post" action="/insertAdmin" enctype="multipart/form-data">
                            <div class="card-body form-section">
                                <h4 class="card-title text-center text-dark">Personal Information</h4>

                                <!-- First Name -->
                                <div class="form-group row">
                                    <label for="fname" class="col-sm-3 text-right control-label col-form-label">First
                                        Name</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" name="fname" id="fname"
                                            placeholder="Enter First Name">
                                    </div>
                                </div>

                                <!-- Last Name -->
                                <div class="form-group row">
                                    <label for="lname" class="col-sm-3 text-right control-label col-form-label">Last
                                        Name</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" name="lname" id="lname"
                                            placeholder="Enter Last Name">
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="form-group row">
                                    <label for="email"
                                        class="col-sm-3 text-right control-label col-form-label">Email</label>
                                    <div class="col-sm-9">
                                        <input type="email" class="form-control" name="email" id="email"
                                            placeholder="Enter Email">
                                    </div>
                                </div>

                                <!-- Password -->
                                <div class="form-group row">
                                    <label for="password"
                                        class="col-sm-3 text-right control-label col-form-label">Password</label>
                                    <div class="col-sm-9">
                                        <input type="password" class="form-control" name="password" id="password"
                                            placeholder="Create Password">
                                    </div>
                                </div>

                                <!-- Contact -->
                                <div class="form-group row">
                                    <label for="phone" class="col-sm-3 text-right control-label col-form-label">Contact
                                        No</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" name="phone" id="phone"
                                            placeholder="Enter Contact Number">
                                    </div>
                                </div>

                                <!-- Gender -->
                                <div class="form-group row">
                                    <label class="col-sm-3 text-right control-label col-form-label">Gender</label>
                                    <div class="col-md-9">
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" value="Male"
                                                id="customControlValidation1" name="gender" required>
                                            <label class="custom-control-label"
                                                for="customControlValidation1">Male</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" value="Female"
                                                id="customControlValidation2" name="gender" required>
                                            <label class="custom-control-label"
                                                for="customControlValidation2">Female</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Hobby -->
                                <div class="form-group row">
                                    <label class="col-sm-3 text-right control-label col-form-label">Hobby</label>
                                    <div class="col-md-9">
                                        <% ["Cricket", "Badminton" ,"Yoga", "Other" ].map((Hobby, index)=> { %>
                                            <div class="custom-control custom-checkbox custom-control-inline">
                                                <input type="checkbox" name="Hobby[]" value="<%= Hobby %>"
                                                    class="custom-control-input"
                                                    id="customControlAutosizing<%= index+1 %>">
                                                <label class="custom-control-label"
                                                    for="customControlAutosizing<%= index+1 %>">
                                                    <%= Hobby %>
                                                </label>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>

                                <!-- City -->
                                <div class="form-group row">
                                    <label class="col-sm-3 text-right control-label col-form-label">City</label>
                                    <div class="col-md-9">
                                        <select class="select2 form-control custom-select" name="city"
                                            style="width: 100%; height:36px;">
                                            <option>Select</option>
                                            <option value="Surat">Surat</option>
                                            <option value="Baroda">Baroda</option>
                                            <option value="Navsari">Navsari</option>
                                            <option value="Rajkot">Rajkot</option>
                                            <option value="Mubai">Mubai</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- About -->
                                <div class="form-group row">
                                    <label class="col-sm-3 text-right control-label col-form-label">About</label>
                                    <div class="col-sm-9">
                                        <textarea class="form-control" name="about"
                                            placeholder="Tell something about admin..."></textarea>
                                    </div>
                                </div>

                                <!-- Profile Image -->
                                <div class="form-group row">
                                    <label class="col-sm-3 text-right control-label col-form-label">
                                        Profile Image
                                    </label>
                                    <div class="col-md-9">
                                        <input type="file" name="profile_image" class="form-control" required>
                                    </div>
                                </div>
                            </div>

                            <div class="border-top text-center">
                                <div class="card-body">
                                    <button type="submit" class="submit-btn">
                                        🚀 Submit Admin
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>