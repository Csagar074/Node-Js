<%- include('header') %>

  <div class="page-wrapper">
    <div class="page-breadcrumb">
      <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
          <h4 class="page-title">All Admin</h4>
        </div>
      </div>
    </div>

    <div class="container-fluid">
      <div class="row">
        <div class="col-12">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Admin List</h5>

              <div class="table-responsive">
                <table id="zero_config" class="table table-striped table-bordered">
                  <thead class="text-center">
                    <tr>
                      <th>No</th>
                      <th>First Name</th>
                      <th>Last Name</th>
                      <th>Email</th>
                      <th>Password</th>
                      <th>Phone</th>
                      <th>Gender</th>
                      <th>Hobby</th>
                      <th>City</th>
                      <th>About</th>
                      <th>Image</th>
                      <th colspan="2">Action</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% allAdmin.map((admin, index)=> { %>
                      <tr class="text-center">

                        <td>
                          <%= index + 1 %>
                        </td>

                        <td>
                          <%= admin.fname %>
                        </td>
                        <td>
                          <%= admin.lname %>
                        </td>
                        <td>
                          <%= admin.email %>
                        </td>
                        <td>
                          <%= admin.password %>
                        </td>
                        <td>
                          <%= admin.phone %>
                        </td>
                        <td>
                          <%= admin.gender %>
                        </td>

                        <!-- Handle hobby as string OR array -->

                          <td class="detail-item">
                            <i class="ri-heart-fill"></i>
                            <span class="hobbies-text">
                                <%= admin['Hobby'] %>
                            </span>
                          </td>

                        <td>
                          <%= admin.city %>
                        </td>
                        <td>
                          <%= admin.about %>
                        </td>



                        <td>
                          <img src="/<%= admin.profile_image %>" width="100" alt="profile">
                        </td>

                        <!-- DELETE -->
                        <td>
                          <a href="/deleteAdmin/<%= admin._id %>" class="btn btn-danger">
                            Delete
                          </a>
                        </td>

                        <!-- EDIT -->
                        <td>
                          <a href="/editAdmin/<%= admin._id %>" class="btn btn-warning">
                            Edit
                          </a>
                        </td>

                      </tr>
                      <% }) %>
                  </tbody>
                </table>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <%- include('footer') %>