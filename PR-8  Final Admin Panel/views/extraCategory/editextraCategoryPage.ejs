<%- include('../header') %>

    <style>
        /* 1. Page & Card Background */
        .page-wrapper {
            background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
            min-height: 100vh;
            padding-bottom: 50px;
        }

        .card {
            background: rgba(255, 255, 255, 0.08) !important;
            backdrop-filter: blur(20px);
            border-radius: 25px !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
            margin-top: 20px;
        }


        .form-control,
        .custom-select {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            border-radius: 12px !important;
            color: white !important;
            padding: 12px 18px !important;
        }

        .form-control:focus {
            border-color: #ff416c !important;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4) !important;
        }

        label {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 600;
        }

        .page-title,
        .card-title {
            color: white !important;
            font-weight: 700;
        }


        .img-selector {
            display: none;
        }

        .img-card {
            cursor: pointer;
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.03);
            display: inline-block;
            width: 110px;
        }

        .img-card img {
            width: 60px;
            height: 60px;
            object-fit: contain;
            margin-bottom: 8px;
            filter: grayscale(100%);
            /* Unselected image grey dikhegi */
            transition: all 0.3s ease;
        }

        .img-card span {
            display: block;
            color: rgba(255, 255, 255, 0.6);
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* 4. Selection Effects (Jab click karein) */
        .img-selector:checked+.img-card {
            border-color: #ff416c;
            background: rgba(255, 65, 108, 0.2);
            box-shadow: 0 0 20px rgba(255, 65, 108, 0.5);
            transform: scale(1.05);
        }

        .img-selector:checked+.img-card img {
            filter: grayscale(0%);
            /* Selected hote hi color aa jayega */
        }

        .img-selector:checked+.img-card span {
            color: #ff416c;
        }

        /* 5. Update Button */
        .update-btn {
            background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
            border: none;
            border-radius: 50px;
            padding: 15px 50px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
            box-shadow: 0 10px 20px rgba(255, 65, 108, 0.3);
            transition: 0.3s;
        }

        .update-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(255, 65, 108, 0.5);
        }

        .profile-preview {
            border-radius: 50%;
            border: 3px solid #ff416c;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4);
        }
    </style>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">category Control Panel</h4>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card">
                        <form class="form-horizontal" method="post" action="/extraCategory/editextraCategory/<%= singleCategory.id %>">
                        
                            <div class="card-body">
                                <h4 class="card-title text-center mb-5">⚙️ Update Extra Category Details</h4>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label>Extra Category Name</label>
                                        <input type="text" class="form-control" name="extracategory_name"
                                            value="<%= singleCategory.extracategory_name %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label>Select Category</label>
                                        <select class="form-control" name="category_id">
                                            <% allCategory.forEach(cat => { %>
                                                <option value="<%= cat.id %>" <%= (singleCategory.category_id && cat.id == singleCategory.category_id._id) ? 'selected' : '' %>>
                                                    <%= cat.category_name %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label>Select Sub Category</label>
                                        <select class="form-control" name="subcategory_id">
                                            <% allSubCategory.forEach(sub => { %>
                                                <option value="<%= sub.id %>" <%= (singleCategory.subcategory_id && sub.id == singleCategory.subcategory_id._id) ? 'selected' : '' %>>
                                                    <%= sub.subcategory_name %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center pb-5">
                                <button type="submit" class="update-btn">🚀 Update Extra Category</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>