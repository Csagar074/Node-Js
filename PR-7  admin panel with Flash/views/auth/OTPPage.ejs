<!DOCTYPE html>
<html dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OTP Verification - Secure Access</title>
    <link href="dist/css/style.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.18/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        /* 1. Main Background matching your Login/Admin theme */
        .auth-wrapper {
            background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 2. Glassmorphism Card Design */
        .auth-box {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 25px !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            padding: 40px 30px !important;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3) !important;
            color: white;
            text-align: center;
        }

        /* 3. Icon and Text Styling */
        .otp-icon {
            font-size: 50px;
            margin-bottom: 20px;
            display: block;
            color: #ff416c;
        }

        .auth-box h3 {
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .auth-box p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 30px;
        }

        /* 4. Modern OTP Input Styling */
        .form-control-otp {
            background: rgba(255, 255, 255, 0.08) !important;
            border: 2px solid rgba(255, 255, 255, 0.2) !important;
            border-radius: 15px !important;
            font-size: 24px !important;
            height: 60px !important;
            text-align: center !important;
            color: white !important;
            letter-spacing: 10px; /* Digits ke beech space */
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .form-control-otp:focus {
            border-color: #ff416c !important;
            background: rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4);
            outline: none;
        }

        /* 5. Gradient Button */
        .btn-verify {
            background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
            border: none !important;
            border-radius: 15px !important;
            padding: 15px !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: white !important;
            width: 100%;
            margin-top: 20px;
            box-shadow: 0 10px 20px rgba(255, 65, 108, 0.3);
            transition: 0.4s ease;
        }

        .btn-verify:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(255, 65, 108, 0.5);
            filter: brightness(1.1);
        }

        /* Resend Link */
        .resend-link {
            display: block;
            margin-top: 25px;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            font-size: 13px;
        }

        .resend-link span {
            color: #ff416c;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="main-wrapper">
        <div class="auth-wrapper">
            <div class="auth-box">
                <div id="otpform">
                    <div class="text-center">
                        <span class="otp-icon">✉️</span>
                        <h3>Verify OTP</h3>
                        <p>Humne aapke email par ek verification code bheja hai.</p>
                    </div>
                    
                    <form class="form-horizontal m-t-20" method="post" action="/otp-verify">
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <input type="number" 
                                           class="form-control form-control-otp" 
                                           name="adminOTP"
                                           placeholder="000000" 
                                           required 
                                           maxlength="6"
                                           oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);">
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <button class="btn btn-verify" type="submit">Verify & Login</button>
                            </div>
                        </div>
                    </form>

                    <a href="#" class="resend-link">OTP nahi mila? <span>Resend Code</span></a>
                </div>
            </div>
        </div>
    </div>

    <script src="assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.18/dist/sweetalert2.all.min.js"></script>
    <script>
        $(".preloader").fadeOut();

        <% if (locals.flash.success && locals.flash.success.length > 0) { %>
          Swal.fire({
            title: "Success !",
            text: "<%= locals.flash.success %>",
            icon: "success"
          });
        <% } %>
        <% if (locals.flash.error && locals.flash.error.length > 0) { %>
          Swal.fire({
            title: "Error !",
            text: "<%= locals.flash.error %>",
            icon: "error"
          });
        <% } %>
    </script>
</body>
</html>