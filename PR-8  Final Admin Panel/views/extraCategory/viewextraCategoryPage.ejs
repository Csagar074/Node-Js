<%- include('../header') %>

    <style>
        .page-wrapper {
            background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
            min-height: 100vh;
            padding-bottom: 50px;
        }

        .card {
            background: rgba(255, 255, 255, 0.08) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 25px !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
            margin-top: 20px;
            color: white;
        }

        .page-title,
        .card-title {
            color: #ffffff !important;
            font-weight: 800;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }

        .table {
            color: white !important;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

        .table thead th {
            background: rgba(255, 255, 255, 0.1) !important;
            border: none !important;
            color: #ff416c !important;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 1px;
            padding: 15px;
        }

        .table tbody tr {
            background: rgba(255, 255, 255, 0.05) !important;
            transition: all 0.3s ease;
            border-radius: 15px;
        }

        .table tbody tr:hover {
            background: rgba(255, 255, 255, 0.15) !important;
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .table td {
            border: none !important;
            vertical-align: middle !important;
            padding: 15px !important;
        }

        .profile-img {
            border-radius: 12px;
            border: 2px solid #ff416c;
            transition: transform 0.3s ease;
            box-shadow: 0 0 10px rgba(255, 65, 108, 0.3);
        }

        .profile-img:hover {
            transform: scale(1.8);
            z-index: 100;
            border-color: #fff;
        }

        .btn-edit {
            background: #f39c12 !important;
            border-radius: 30px;
            color: white !important;
            border: none;
            padding: 5px 15px;
            font-weight: 600;
        }

        .btn-delete {
            background: #e74c3c !important;
            border-radius: 30px;
            color: white !important;
            border: none;
            padding: 5px 15px;
            font-weight: 600;
        }
    </style>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Extra category Directory</h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active">category List</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">👥 Manage Categoryistrators</h5>

                            <div class="table-responsive">
                                <table class="table text-center">

                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Extra Category Name</th>
                                            <th>Category Name</th>
                                            <th>Sub Category Name</th>
                                            <% if(admin && admin.id==="6960a3d703698c402a41bfe1" ) { %>
                                                <th>Actions</th>
                                                <% } %>
                                        </tr>
                                    </thead>

                                    <tbody id="adminTable">
                                        <% allextraCategory.map((data, index)=> { %>
                                            <tr>
                                                <td>
                                                    <%= index + 1 %>
                                                </td>
                                                <td>
                                                    <%= data.extracategory_name %>
                                                </td>
                                                <td>
                                                    <%= data.category_id ? data.category_id.category_name : 'N/A' %>
                                                </td>
                                                <td>
                                                    <%= data.subcategory_id ? data.subcategory_id.subcategory_name : 'N/A' %>
                                                </td>

                                                <% if(admin.id==="6960a3d703698c402a41bfe1" ) { %>
                                                    <td>
                                                        <a href="/extraCategory/editextraCategory/<%= data.id %>"
                                                            class="btn btn-edit btn-sm mr-2">
                                                            <i class="mdi mdi-pencil"></i> Edit
                                                        </a>
                                                        <a href="/extraCategory/deletextraCategory?extracategoryId=<%= data.id %>"
                                                            class="btn btn-delete btn-sm"
                                                            onclick="return confirm('Delete this extra category?')">
                                                            <i class="mdi mdi-delete"></i> Delete
                                                        </a>
                                                    </td>
                                                    <% } %>
                                            </tr>
                                            <% }) %>
                                    </tbody>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>