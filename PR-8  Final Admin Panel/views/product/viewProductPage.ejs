<%- include('../header') %>

    <style>
        .page-wrapper {
            background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
            min-height: 100vh;
            padding-bottom: 50px;
        }


        .card {
            background: rgba(255, 255, 255, 0.08) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 25px !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
            margin-top: 20px;
            color: white;
        }

        .page-title,
        .card-title {
            color: #ffffff !important;
            font-weight: 800;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }


        .table {
            color: white !important;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

        .table thead th {
            background: rgba(255, 255, 255, 0.1) !important;
            border: none !important;
            color: #ff416c !important;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 1px;
            padding: 15px;
        }

        .table tbody tr {
            background: rgba(255, 255, 255, 0.05) !important;
            transition: all 0.3s ease;
            border-radius: 15px;
        }

        .table tbody tr:hover {
            background: rgba(255, 255, 255, 0.15) !important;
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .table td {
            border: none !important;
            vertical-align: middle !important;
            padding: 15px !important;
        }


        .profile-img {
            border-radius: 12px;
            border: 2px solid #ff416c;
            transition: transform 0.3s ease;
            box-shadow: 0 0 10px rgba(255, 65, 108, 0.3);
        }

        .profile-img:hover {
            transform: scale(1.8);
            z-index: 100;
            border-color: #fff;
        }

        .badge-custom {
            padding: 8px 12px;
            border-radius: 8px;
            font-weight: 600;
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            color: white;
            border: none;
        }


        .btn-edit {
            background: #f39c12 !important;
            border-radius: 30px;
            color: white !important;
            border: none;
            padding: 5px 15px;
            font-weight: 600;
        }

        .btn-delete {
            background: #e74c3c !important;
            border-radius: 30px;
            color: white !important;
            border: none;
            padding: 5px 15px;
            font-weight: 600;
        }

        /* Breadcrumb color */
        .breadcrumb-item a {
            color: rgba(255, 255, 255, 0.7);
        }

        .breadcrumb-item.active {
            color: white;
        }

        /* Search Box styling */
        .search-container input {
            background: rgba(255, 255, 255, 0.1) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            border-radius: 50px !important;
            padding: 10px 20px;
        }
    </style>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Products Directory</h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active">Product List</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="card-title">👥 Manage Productistrators</h5>

                            </div>

                            <div class="table-responsive">
                                <table class="table text-center">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Image</th>
                                            <th>Title</th>
                                            <th>Category</th>
                                            <th>Sub Category</th>
                                            <th>Extra Category</th>
                                            <th>Old Price</th>
                                            <th>Price</th>
                                            <th>Stock</th>
                                            <% if(admin && admin.id==="6960a3d703698c402a41bfe1" ) {%>
                                                <th>Actions</th>
                                                <% } %>
                                        </tr>
                                    </thead>
                                    <tbody id="adminTable">
                                        <% allProduct.map((data, index)=> { %>
                                            <tr>
                                                <td>
                                                    <%= index + 1 %>
                                                </td>
                                                <td>
                                                    <% if(data.product_img) { %>
                                                        <img src="/<%= data.product_img %>" width="50" height="50"
                                                            class="profile-img" alt="Product">
                                                        <% } else { %>
                                                            <span>No Image</span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <%= data.product_name || 'N/A' %>
                                                </td>
                                                <td>
                                                    <%= data.category_id ? data.category_id.category_name : 'N/A' %>
                                                </td>
                                                <td>
                                                    <%= data.subcategory_id ? data.subcategory_id.subcategory_name
                                                        : 'N/A' %>
                                                </td>
                                                <td>
                                                    <%= data.extraCategory_id ? data.extraCategory_id.extracategory_name
                                                        : 'N/A' %>
                                                </td>
                                                  <td>
                                                    <%= data.old_price %>
                                                </td>
                                                <td>
                                                    <%= data.new_price || data.old_price || 'N/A' %>
                                                </td>
                                                 
                                                <td>
                                                    <%= data.stock || 0 %>
                                                </td>

                                                <% if(admin && admin.id==="6960a3d703698c402a41bfe1" ) {%>
                                                    <td>
                                                        <a href="/product/editProduct/<%= data.id %>"
                                                            class="btn btn-edit btn-sm mr-2">
                                                            <i class="mdi mdi-pencil"></i> Edit
                                                        </a>
                                                        <a href="/product/deleteProduct/<%= data.id %>"
                                                            class="btn btn-delete btn-sm"
                                                            onclick="return confirm('Delete this product?')">
                                                            <i class="mdi mdi-delete"></i> Delete
                                                        </a>
                                                    </td>
                                                    <% } %>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Modern Search Filter
        document.getElementById("searchInput").addEventListener("keyup", function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#adminTable tr");

            rows.forEach(row => {
                let text = row.textContent.toLowerCase();
                row.style.opacity = text.includes(filter) ? "1" : "0";
                setTimeout(() => {
                    row.style.display = text.includes(filter) ? "" : "none";
                }, 200);
            });
        });
    </script>

    <%- include('../footer') %>