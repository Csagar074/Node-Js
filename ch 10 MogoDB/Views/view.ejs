<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Books View</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .card img {
            height: 250px;
            object-fit: cover;
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
        }

        .price-badge {
            background-color: #75e479;
            color: #fff;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 14px;
        }

        .lang-badge {
            background-color: #abc452;
            color: #fff;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <!-- Heading -->
    <h1 class="text-center fw-bold py-5 text-primary">📚 All Books Show</h1>

    <!-- Books Section -->
    <section class="books_section">
        <div class="container">
            <div class="row">

                <% allBooks.map((book, i)=> { %>
                    <div class="col-lg-4 col-md-6 col-sm-12 my-4">
                        <div class="card h-60">

                            <img src="<%= book.book_image %>" class="card-img-top" alt="Book Image">

                            <div class="card-body d-flex flex-column">

                                <h4 class="card-title text-center fw-bold">
                                    <%= book.book_name %>
                                </h4>

                                <p class="text-center text-muted mb-3">
                                    by <%= book.book_author %>
                                </p>

                                <div class="d-flex justify-content-between mb-3">
                                    <span class="price-badge">
                                        ₹ <%= book.book_price %>
                                    </span>
                                    <span class="lang-badge">
                                        <%= book.book_lang %>
                                    </span>
                                </div>

                                <div class="mt-auto d-flex justify-content-center gap-3">
                                    <a href="#" class="btn btn-outline-info btn-sm px-4">Edit</a>
                                    <a href="/deleteBook?bookId=<%= book._id %>"
                                        class="btn btn-outline-success btn-sm px-4">Delete</a>
                                </div>

                            </div>
                        </div>
                    </div>
                <% }) %>

            </div>
        </div>
    </section>

    <!-- Add Book Button -->
    <section class="addNewBook text-center py-5">
        <a href="/addBookPage" class="btn btn-lg btn-outline-primary px-5">
            ➕ Add New Book
        </a>
    </section>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
