<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurant Management Form</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

  <div class="container mt-4">
    <h2 class="text-center mb-3">Restaurant Management Form</h2>

    <form class="card p-4 shadow" action="/addUser"></form>

      <h5 class="text-primary mb-3">Restaurant Details</h5>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Restaurant Name</label>
          <input type="text" class="form-control" placeholder="Enter restaurant name" required>
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Owner Name</label>
          <input type="text" class="form-control" placeholder="Enter owner name">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Restaurant Email</label>
        <input type="email" class="form-control" placeholder="Enter your Email">
      </div>
       <div class="mb-3">
        <label class="form-label">Restaurant Password</label>
        <input type="password" class="form-control" placeholder="Enter your Password">
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Contact Number</label>
          <input type="tel" class="form-control" placeholder="Enter phone number">
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Address</label>
          <input type="text" class="form-control" placeholder="Enter your address">
        </div>
      </div>

      <hr>

      <button class="btn btn-success w-50 ">Submit</button>
    </form>
     <a href="/addUser">View Restarant Table</a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
