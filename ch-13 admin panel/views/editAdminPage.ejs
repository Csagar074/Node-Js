<%- include('header') %>

  <div class="page-wrapper">
    <div class="page-breadcrumb">
      <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
          <h4 class="page-title">Add Admin Page</h4>
        </div>
      </div>
    </div>

    <div class="container-fluid">
      <div class="row">
        <div class="col-md-6">
          <div class="card">

            <form class="form-horizontal" method="post" action="/updateAdmin/<%= adminData._id %>"
              enctype="multipart/form-data">

              <div class="card-body">
                <h4 class="card-title">Personal Info</h4>

                <!-- First Name -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">First Name</label>
                  <div class="col-sm-9">
                    <input type="text" class="form-control" value="<%= adminData.fname %>" name="fname"
                      placeholder="First Name Here" required>
                  </div>
                </div>

                <!-- Last Name -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">Last Name</label>
                  <div class="col-sm-9">
                    <input type="text" class="form-control" value="<%= adminData.lname %>" name="lname"
                      placeholder="Last Name Here" required>
                  </div>
                </div>

                <!-- Email -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">Email</label>
                  <div class="col-sm-9">
                    <input type="email" class="form-control" value="<%= adminData.email %>" name="email"
                      placeholder="Enter email" required>
                  </div>
                </div>

                <!-- Password -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">Password</label>
                  <div class="col-sm-9">
                    <input type="password" class="form-control" value="<%= adminData.password %>" name="password"
                      placeholder="Password Here" required>
                  </div>
                </div>

                <!-- Contact -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">Contact No</label>
                  <div class="col-sm-9">
                    <input type="text" class="form-control" value="<%= adminData.phone %>" name="phone"
                      placeholder="Contact No Here">
                  </div>
                </div>

                <!-- Gender -->
                <div class="form-group row">
                  <label class="col-md-3">Gender</label>
                  <div class="col-md-9">
                    <div class="custom-control custom-radio">
                      <input type="radio" name="gender" value="Male" class="custom-control-input" id="genderMale"
                        <%=adminData.gender==="Male" ? "checked" : "" %> >
                      <label class="custom-control-label" for="genderMale">Male</label>

                      <input type="radio" name="gender" value="Female" class="custom-control-input" id="genderFemale"
                        <%=adminData.gender==="Female" ? "checked" : "" %> >
                      <label class="custom-control-label" for="genderFemale">Female</label>

                      <input type="radio" name="gender" value="Other" class="custom-control-input" id="genderOther"
                        <%=adminData.gender==="Other" ? "checked" : "" %> >
                      <label class="custom-control-label" for="genderOther">Other</label>

                    </div>
                  </div>
                </div>

                <!-- Hobby -->
                <div class="form-group row">
                  <label class="col-md-3">Hobby</label>

                  <div class="col-md-9">

                    <!-- <% const hobbies=Array.isArray(adminData.Hobby) ? adminData.Hobby : (adminData.Hobby ?
                      adminData.Hobby.split(",") : []); %> -->

                      <input type="checkbox" name="Hobby" value="Reading" id="hobbyReading" class="custom-control-input"
                        <%=hobbies.includes("Reading") ? "checked" : "" %> >
                      <label class="custom-control-label" for="hobbyReading">Reading</label>

                      <input type="checkbox" name="Hobby" value="Cricket" id="hobbyCricket" class="custom-control-input"
                        <%=hobbies.includes("Cricket") ? "checked" : "" %> >
                      <label class="custom-control-label" for="hobbyCricket">Cricket</label>

                      <input type="checkbox" name="Hobby" value="Uno" id="hobbyUno" class="custom-control-input"
                        <%=hobbies.includes("Uno") ? "checked" : "" %> >
                      <label class="custom-control-label" for="hobbyUno">Uno</label>


                  </div>
                </div>



                <!-- City -->
                <div class="form-group row">
                  <label class="col-md-3 m-t-15">City</label>
                  <div class="col-md-9">
                    <select class="form-control" name="city">
                      <option value="">Select City</option>
                      <option value="Surat" <%=adminData.city==="Surat" ? "selected" : "" %>>Surat</option>
                      <option value="Baroda" <%=adminData.city==="Baroda" ? "selected" : "" %>>Baroda</option>
                      <option value="Anand" <%=adminData.city==="Anand" ? "selected" : "" %>>Anand</option>
                      <option value="Bhavnagar" <%=adminData.city==="Bhavnagar" ? "selected" : "" %>>Bhavnagar</option>
                      <option value="Rajkot" <%=adminData.city==="Rajkot" ? "selected" : "" %>>Rajkot</option>
                    </select>
                  </div>
                </div>

                <!-- About -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">About</label>
                  <div class="col-sm-9">
                    <textarea class="form-control" value="<%= adminData.about %>" name="about"></textarea>
                  </div>
                </div>

                <!-- Profile Image -->
                <div class="form-group row">
                  <label class="col-sm-3 text-right control-label col-form-label">Profile Image</label>
                  <div class="col-md-9">
                    <input type="file" name="profile_image" class="form-control-file" required>
                  </div>
                </div>


              </div>
              <div class="border-top">
                <div class="card-body">
                  <button type="submit" class="btn btn-primary">Update</button>
                </div>
              </div>

            </form>

          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('footer') %>