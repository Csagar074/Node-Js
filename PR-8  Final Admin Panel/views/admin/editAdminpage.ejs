<%- include('../header') %>

    <style>
        /* 1. Page & Card Background */
        .page-wrapper {
            background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
            min-height: 100vh;
            padding-bottom: 50px;
        }

        .card {
            background: rgba(255, 255, 255, 0.08) !important;
            backdrop-filter: blur(20px);
            border-radius: 25px !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
            margin-top: 20px;
        }


        .form-control,
        .custom-select {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            border-radius: 12px !important;
            color: white !important;
            padding: 8px 18px !important;
        }

        .form-control:focus {
            border-color: #ff416c !important;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4) !important;
        }

        /* Make select dropdowns dark and ensure selected text is visible */
        select.form-control.custom-select {
            background: rgba(255, 255, 255, 0.03) !important;
            color: white !important;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

        /* Options inside dropdown should be dark so the list looks consistent */
        select.form-control.custom-select option {
            background: linear-gradient(135deg, rgba(46,26,71,0.95), rgba(195,20,50,0.95)) !important;
            color: white !important;
        }

        /* Placeholder / disabled option styling */
        select.form-control.custom-select option[disabled] {
            color: rgba(255,255,255,0.6) !important;
        }

        /* Sometimes selected option inherits browser defaults — force visible color */
        select.form-control.custom-select::-ms-expand { display: none; }

        label {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 600;
        }

        .page-title,
        .card-title {
            color: white !important;
            font-weight: 700;
        }


        .custom-control-label {
            color: white !important;
            cursor: pointer;
        }

        .custom-control-input:checked~.custom-control-label::before {
            background-color: #ff416c !important;
            border-color: #ff416c !important;
        }

        /* 5. Update Button */
        .update-btn {
            background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
            border: none;
            border-radius: 50px;
            padding: 15px 50px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
            box-shadow: 0 10px 20px rgba(255, 65, 108, 0.3);
            transition: 0.3s;
        }

        .update-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(255, 65, 108, 0.5);
        }

        .profile-preview {
            border-radius: 50%;
            border: 3px solid #ff416c;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4);
        }
    </style>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Admin Control Panel</h4>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card">
                        <form class="form-horizontal" method="post" action="/editAdmin/<%= singleAdmin.id %>"
                            enctype="multipart/form-data">
                            <div class="card-body">
                                <h4 class="card-title text-center mb-5">⚙️ Update Account Details</h4>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label>First Name</label>
                                        <input type="text" class="form-control" name="fname"
                                            value="<%= singleAdmin.fname %>">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label>Last Name</label>
                                        <input type="text" class="form-control" name="lname"
                                            value="<%= singleAdmin.lname %>">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label>Email</label>
                                        <input type="email" class="form-control" name="email"
                                            value="<%= singleAdmin.email %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label>Contact</label>
                                        <input type="text" class="form-control" name="phone"
                                            value="<%= singleAdmin.phone %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label>City</label>
                                        <select class="form-control custom-select" name="city">
                                            <% ["Surat", "Baroda" , "Navsari" , "Rajkot" , "Mumbai" ].map((city)=> { %>
                                                <option value="<%= city %>" <%=(singleAdmin.city===city) ? 'selected'
                                                    : '' %>><%= city %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>

                                <hr style="border-top: 1px solid rgba(255,255,255,0.1); margin: 30px 0;">

                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <label class="d-block mb-3">Gender</label>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" value="Male" id="male" name="gender" <%=(singleAdmin.gender==='Male') ? 'checked' : '' %> required>
                                            <label class="custom-control-label" for="male">Male</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" value="Female" id="female" name="gender" <%=(singleAdmin.gender==='Female') ? 'checked' : '' %> required>
                                            <label class="custom-control-label" for="female">Female</label>
                                        </div>
                                        <div class="custom-control custom-radio custom-control-inline">
                                            <input type="radio" class="custom-control-input" value="Other" id="other" name="gender" <%=(singleAdmin.gender==='Other') ? 'checked' : '' %> required>
                                            <label class="custom-control-label" for="other">Other</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="d-block mb-3">Hobbies</label>
                                        <% ["Cricket", "Badminton", "Yoga", "UNO"].map((Hobby, index) => { %>
                                        <div class="custom-control custom-checkbox custom-control-inline">
                                            <input type="checkbox" name="Hobby[]" value="<%= Hobby %>" class="custom-control-input" id="hobby<%= index %>" <%=(singleAdmin.Hobby && singleAdmin.Hobby.includes(Hobby)) ? 'checked' : '' %>>
                                            <label class="custom-control-label" for="hobby<%= index %>"><%= Hobby %></label>
                                        </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <div class="form-group mt-4">
                                    <label>Profile Biography</label>
                                    <textarea class="form-control" name="about" rows="3"
                                        placeholder="Tell us something..."><%= singleAdmin.about %></textarea>
                                </div>

                                <div class="row align-items-center mt-4">
                                    <div class="col-md-2 text-center">
                                        <img src="/<%= singleAdmin.profile_image %>" height="100" width="100"
                                            class="profile-preview" alt="Admin">
                                    </div>
                                    <div class="col-md-10">
                                        <label>Update Profile Picture</label>
                                        <input type="file" name="profile_image" class="form-control">
                                    </div>
                                </div>
                            </div>

                            <div class="text-center pb-5">
                                <button type="submit" class="update-btn">🚀 Update Admin</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>