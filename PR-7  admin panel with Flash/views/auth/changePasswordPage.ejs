<%- include('../header') %>

<style>
    /* 1. Background matching Login/Admin theme */
    .page-wrapper {
        background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 2. Glassmorphism Card Style */
    .password-card {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border-radius: 25px !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3) !important;
        overflow: hidden;
        color: white;
        padding: 20px;
    }

    /* 3. Header Styling */
    .card-header-custom {
        background: transparent;
        color: white;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 20px;
        margin-bottom: 20px;
    }

    .card-header-custom h4 {
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-size: 1.2rem;
    }

    /* 4. Glassy Form Controls */
    .form-group label {
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
        margin-left: 10px;
        font-size: 14px;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        border-radius: 15px !important;
        padding: 12px 20px !important;
        color: white !important;
        transition: all 0.3s ease;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.15) !important;
        border-color: #ff416c !important;
        box-shadow: 0 0 15px rgba(255, 65, 108, 0.3);
        outline: none;
    }

    /* 5. Glowing Action Button */
    .btn-custom {
        width: 100%;
        border-radius: 15px;
        padding: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
        border: none !important;
        color: white !important;
        text-transform: uppercase;
        box-shadow: 0 10px 20px rgba(255, 65, 108, 0.3);
        transition: all 0.4s ease;
    }

    .btn-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(255, 65, 108, 0.5);
        filter: brightness(1.1);
    }

    /* Optional: Icon colors */
    .input-icon {
        color: #ff416c;
    }
</style>

<div class="page-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-sm-10">
                <div class="card password-card">

                    <div class="card-header-custom">
                        <h4><span class="input-icon">🛡️</span> Security Update</h4>
                        <p style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 5px;">Secure your account with a strong password</p>
                    </div>

                    <form class="form-horizontal" method="post" action="/change-password">
                        <div class="card-body p-2">

                            <div class="form-group mb-4">
                                <label><i class="mdi mdi-lock-open-outline"></i> Current Password</label>
                                <input type="password" class="form-control" name="current_psw"
                                    placeholder="••••••••" required>
                            </div>

                            <div class="form-group mb-4">
                                <label><i class="mdi mdi-lock-outline"></i> New Password</label>
                                <input type="password" class="form-control" name="new_psw"
                                    placeholder="Enter new password" required>
                            </div>

                            <div class="form-group mb-4">
                                <label><i class="mdi mdi-check-all"></i> Confirm New Password</label>
                                <input type="password" class="form-control" name="conform_psw"
                                    placeholder="Repeat new password" required>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-custom">
                                    Update Password Now
                                </button>
                            </div>

                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Auto-logout after successful password change
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('logout') === 'true') {
        setTimeout(() => {
            window.location.href = '/logout';
        }, 3000); // Wait 3 seconds for user to see the toast before logging out
    }
</script>

<%- include('../footer') %>