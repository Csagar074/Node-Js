<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Employee</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="../dist/style.css">
</head>

<body>
    <a href="/form/employee"
        style="text-decoration: none; display: inline-block; color: rgb(0, 0, 59); margin-left: 170px; ">⇐ Go to Add
        Employee Form</a><br>
    <h1 style="display: inline-block; margin-left: 170px; margin-top: 10px;">All Employees</h1>
    <br>
    <div class="container">
        <div class="employee-grid">
            <% allEmp.map((employee , index)=> { %>
                <div class="employee-card">
                    <div class="card-header"></div>

                    <div class="profile-section">
                        <div class="profile-icon">
                            <!-- <i class="ri-user-3-fill"></i> -->
                            <img src="../<%= employee['emp_ProfilePic'] %>" alt="Profile Picture" class="profile-pic"
                                width="61px" style="border-radius: 40%;">
                        </div>
                        <div class="employee-name">
                            <%= employee['emp_Name'] %>
                        </div>
                        <div class="employee-role">
                            <%= employee['emp_Role'] %>
                        </div>
                    </div>

                    <div class="card-divider"></div>

                    <div class="card-details">
                        <div class="detail-item">
                            <i class="ri-mail-fill"></i>
                            <span>
                                <%= employee['emp_Email'] %>
                            </span>
                        </div>

                        <div class="detail-item">
                            <i class="ri-lock-password-fill"></i>
                            <span>
                                <%= employee['emp_Password'] %>
                            </span>
                        </div>

                        <div class="detail-item">
                            <i class="ri-user-fill"></i>
                            <span>
                                <%= employee['emp_gender'] %>
                            </span>
                        </div>

                        <div class="detail-item">
                            <i class="ri-money-rupee-circle-fill"></i>
                            <span class="salary-badge">₹<%= employee['emp_Salary'] %></span>
                        </div>

                        <div class="detail-item">
                            <i class="ri-heart-fill"></i>
                            <span class="hobbies-text">
                                <%= employee['emp_Hobbys'] %>
                            </span>
                        </div>
                        <div class="action-buttons">
                            <button class="action-btn delete">
                                <a href="/form/delete/<%= employee.id %> %>">Delete</a>
                            </button>

                            <button class="action-btn edit">
                                <a href="/form/edit/<%= employee.id %> %>" style="color: rgb(16, 0, 78);">Edit</a>
                            </button>
                        </div>

                    </div>
                </div>
                <% }) %>
        </div>
    </div>
</body>

</html>