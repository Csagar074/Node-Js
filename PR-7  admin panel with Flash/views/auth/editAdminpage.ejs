<%- include('../header') %>

    <style>
        /* 1. Page & Card Background */
        .page-wrapper {
            background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
            min-height: 100vh;
            padding-bottom: 50px;
        }

        .card {
            background: rgba(255, 255, 255, 0.08) !important;
            backdrop-filter: blur(20px);
            border-radius: 25px !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
            margin-top: 20px;
        }


        .form-control,
        .custom-select {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            border-radius: 12px !important;
            color: white !important;
            padding: 12px 18px !important;
        }

        .form-control:focus {
            border-color: #ff416c !important;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4) !important;
        }

        label {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 600;
        }

        .page-title,
        .card-title {
            color: white !important;
            font-weight: 700;
        }


        .img-selector {
            display: none;
        }

        .img-card {
            cursor: pointer;
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.03);
            display: inline-block;
            width: 110px;
        }

        .img-card img {
            width: 60px;
            height: 60px;
            object-fit: contain;
            margin-bottom: 8px;
            filter: grayscale(100%);
            /* Unselected image grey dikhegi */
            transition: all 0.3s ease;
        }

        .img-card span {
            display: block;
            color: rgba(255, 255, 255, 0.6);
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* 4. Selection Effects (Jab click karein) */
        .img-selector:checked+.img-card {
            border-color: #ff416c;
            background: rgba(255, 65, 108, 0.2);
            box-shadow: 0 0 20px rgba(255, 65, 108, 0.5);
            transform: scale(1.05);
        }

        .img-selector:checked+.img-card img {
            filter: grayscale(0%);
            /* Selected hote hi color aa jayega */
        }

        .img-selector:checked+.img-card span {
            color: #ff416c;
        }

        /* 5. Update Button */
        .update-btn {
            background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
            border: none;
            border-radius: 50px;
            padding: 15px 50px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
            box-shadow: 0 10px 20px rgba(255, 65, 108, 0.3);
            transition: 0.3s;
        }

        .update-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(255, 65, 108, 0.5);
        }

        .profile-preview {
            border-radius: 50%;
            border: 3px solid #ff416c;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4);
        }
    </style>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Admin Control Panel</h4>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card">
                        <form class="form-horizontal" method="post" action="/editAdmin/<%= singleAdmin.id %>"
                            enctype="multipart/form-data">
                            <div class="card-body">
                                <h4 class="card-title text-center mb-5">⚙️ Update Account Details</h4>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label>First Name</label>
                                        <input type="text" class="form-control" name="fname"
                                            value="<%= singleAdmin.fname %>">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label>Last Name</label>
                                        <input type="text" class="form-control" name="lname"
                                            value="<%= singleAdmin.lname %>">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label>Email</label>
                                        <input type="email" class="form-control" name="email"
                                            value="<%= singleAdmin.email %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label>Contact</label>
                                        <input type="text" class="form-control" name="phone"
                                            value="<%= singleAdmin.phone %>">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label>City</label>
                                        <select class="form-control custom-select" name="city">
                                            <% ["Surat", "Baroda" , "Navsari" , "Rajkot" , "Mumbai" ].map((city)=> { %>
                                                <option value="<%= city %>" <%=(singleAdmin.city===city) ? 'selected'
                                                    : '' %>><%= city %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>

                                <hr style="border-top: 1px solid rgba(255,255,255,0.1); margin: 30px 0;">

                                <div class="row">
                                    <div class="col-md-5">
                                        <label class="d-block mb-3">Gender Selection</label>
                                        <div class="d-flex">
                                            <div class="mr-3">
                                                <input type="radio" class="img-selector" value="Male" id="m"
                                                    name="gender" <%=(singleAdmin.gender==='Male' ) ? 'checked' : '' %>>
                                                <label class="img-card" for="m">
                                                    <img src="https://cdn-icons-png.flaticon.com/512/4128/4128176.png"
                                                        alt="Male">
                                                    <span>Male</span>
                                                </label>
                                            </div>
                                            <div>
                                                <input type="radio" class="img-selector" value="Female" id="f"
                                                    name="gender" <%=(singleAdmin.gender==='Female' ) ? 'checked' : ''
                                                    %>>
                                                <label class="img-card" for="f">
                                                    <img src="https://cdn-icons-png.flaticon.com/512/6997/6997662.png"
                                                        alt="Female">
                                                    <span>Female</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <label class="d-block mb-3">Admin Hobbies</label>
                                        <div class="d-flex flex-wrap">
                                            <% const hobbyData=[ {name: "Cricket" ,
                                                img: "https://cdn-icons-png.flaticon.com/512/3306/3306616.png" },
                                                {name: "Badminton" ,
                                                img: "https://cdn-icons-png.flaticon.com/512/2906/2906801.png" },
                                                {name: "Yoga" ,
                                                img: "https://cdn-icons-png.flaticon.com/512/3048/3048398.png" } ];
                                                hobbyData.map((hobby, index)=> {
                                                %>
                                                <div class="mr-2 mb-2">
                                                    <input type="checkbox" name="Hobby[]" value="<%= hobby.name %>"
                                                        class="img-selector" id="h<%= index %>" <%=(singleAdmin.Hobby &&
                                                        singleAdmin.Hobby.includes(hobby.name)) ? 'checked' : '' %>>
                                                    <label class="img-card" for="h<%= index %>"
                                                        style="width: 120px; height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                                        <img src="<%= hobby.img %>" alt="<%= hobby.name %>"
                                                            style="width: 60px; height: 60px; object-fit: contain; margin-bottom: 10px;">
                                                        <span style="font-size: 14px;">
                                                            <%= hobby.name %>
                                                        </span>
                                                    </label>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <style>
                                        /* Taaki saare cards ek hi size ke dikhein */
                                        .img-card {
                                            cursor: pointer;
                                            border: 2px solid rgba(255, 255, 255, 0.1);
                                            border-radius: 15px;
                                            background: rgba(255, 255, 255, 0.05);
                                            transition: all 0.3s ease;
                                            text-align: center;
                                        }

                                        /* Checkbox ko hide karne ke liye */
                                        .img-selector {
                                            display: none;
                                        }

                                        /* Selection effect */
                                        .img-selector:checked+.img-card {
                                            border-color: #ff416c;
                                            background: rgba(255, 65, 108, 0.2);
                                            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4);
                                            transform: scale(1.05);
                                        }
                                    </style>
                                </div>

                                <div class="form-group mt-4">
                                    <label>Profile Biography</label>
                                    <textarea class="form-control" name="about" rows="3"
                                        placeholder="Tell us something..."><%= singleAdmin.about %></textarea>
                                </div>

                                <div class="row align-items-center mt-4">
                                    <div class="col-md-2 text-center">
                                        <img src="/<%= singleAdmin.profile_image %>" height="100" width="100"
                                            class="profile-preview" alt="Admin">
                                    </div>
                                    <div class="col-md-10">
                                        <label>Update Profile Picture</label>
                                        <input type="file" name="profile_image" class="form-control">
                                    </div>
                                </div>
                            </div>

                            <div class="text-center pb-5">
                                <button type="submit" class="update-btn">🚀 Update Admin</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../footer') %>