
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Bike</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .bike-card {
            background: #fff;
            border-radius: 15px;
            padding: 30px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        .bike-card h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: bold;
        }
        .btn-custom {
            background: #667eea;
            color: #fff;
            font-weight: 600;
        }
        .btn-custom:hover {
            background: #5a67d8;
            color: #fff;
        }
    </style>
</head>
<body>

    <div class="bike-card">
        <h2>Add Bike</h2>

        <form action="/addBike" method="POST">
             <div class="mb-3">
                <label class="form-label">Bike Image</label>
                <input type="text" name="bike_image" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Bike Name</label>
                <input type="text" name="bike_name" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Bike Brand</label>
                <input type="text" name="bike_brand" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Bike Price (₹)</label>
                <input type="number" name="bike_price" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Bike Color</label>
                <input type="color" name="bike_color" class="form-control form-control-color">
            </div>

            <div class="mb-3">
                <label class="form-label">Engine CC</label>
                <input type="number" name="bike_engine" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Launch Year</label>
                <input type="number" name="bike_launch" class="form-control" required>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-custom">Add Bike</button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a href="/" class="text-decoration-none fw-semibold">← View All Bikes</a>
        </div>
    </div>

</body>
</html>
