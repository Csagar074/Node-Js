<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Book</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(120deg, #1e3c72, #2a5298);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .glass-card h4 {
            font-weight: 600;
        }

        .form-control,
        .form-select {
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.9);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #ff512f, #dd2476);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            color: #fff;
            transition: 0.3s;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        .preview-img {
            height: 160px;
            object-fit: cover;
            border-radius: 12px;
            border: 2px dashed #ccc;
            background: #f8f9fa;
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="glass-card p-4 text-white">

                    <h4 class="text-center mb-4">📘 Add Book Details</h4>

                    <form method="post" action="/addBook">

                        <div class="mb-3">
                            <input type="text" class="form-control" name="book_name"
                                placeholder="📖 Book Name" required>
                        </div>

                        <div class="mb-3">
                            <input type="text" class="form-control" name="book_author"
                                placeholder="✍ Author Name" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <input type="number" class="form-control" name="book_price"
                                    placeholder="₹ Price" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <select class="form-select" name="book_lang" required>
                                    <option value="">🌐 Language</option>
                                    <option>English</option>
                                    <option>Hindi</option>
                                    <option>Gujarati</option>
                                    <option>Marathi</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <input type="text" class="form-control" name="book_image"
                                placeholder="🖼 Image URL">
                        </div>

                        <!-- <div class="mb-4 text-center">
                            <img src="https://via.placeholder.com/150"
                                class="preview-img w-100"
                                alt="Preview Image">
                        </div> -->

                        <div class="d-grid">
                            <button type="submit" class="btn btn-gradient">
                                ➕ Add Book
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
