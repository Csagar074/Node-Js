<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Management | Edit Book</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="../dist/style.css">
</head>

<body>
    <div class="form-container">
        <div class="form-header" style="background-color: rgb(76, 28, 0);">
            <div class="form-icon">
                <i class="fas fa-edit"></i>
            </div>
            <h1 class="form-title">Edit Book Details</h1>
            <p class="form-subtitle">Update the information below to modify the book details</p>
        </div>

        <div class="form-body">
            <form method="post" action="/BookUpdate" enctype="multipart/form-data">
                <input type="hidden" name="id" value="<%= book.id %>">

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="BookName">
                            <i class="fas fa-heading"></i> Book Title
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-heading input-group-icon"></i>
                            <input type="text" name="BookName" id="BookName" class="form-control"
                                value="<%= book.BookName %>" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="BookAuth">
                            <i class="fas fa-user-pen"></i> Author
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-user-pen input-group-icon"></i>
                            <input type="text" name="BookAuth" id="BookAuth" class="form-control"
                                value="<%= book.BookAuth %>" required>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="BookPrice">
                            <i class="fas fa-tag"></i> Price
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-tag input-group-icon"></i>
                            <input type="number" name="BookPrice" id="BookPrice" class="form-control"
                                value="<%= book.BookPrice %>" min="0" step="0.01" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="BookLang">
                            <i class="fas fa-language"></i> Language
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-language input-group-icon"></i>
                            <input type="text" name="BookLang" id="BookLang" class="form-control"
                                value="<%= book.BookLang %>" required>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group full-width">
                        <label class="form-label" for="BookImg">
                            <i class="fas fa-image"></i> Book Cover Image
                        </label>

                        <div class="current-image-container">
                            <img src="/<%= book.BookImg %>" alt="Current Book Cover" class="current-image">
                            <div class="current-image-info">
                                <div class="current-image-label">
                                    <i class="fas fa-image"></i> Current Cover Image
                                </div>
                                <p>This is the current book cover image. Upload a new image below to replace it.</p>
                            </div>
                        </div>

                        <div class="file-upload-container" onclick="document.getElementById('BookImg').click()">
                            <div class="file-upload-icon">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>
                            <div class="file-upload-text">Click to upload new book cover image</div>
                            <div class="file-upload-subtext">PNG, JPG or JPEG (Max. 5MB)</div>
                            <div id="fileNameDisplay">No file selected - current image will be kept</div>
                        </div>
                        <p class="optional-note">* Leave empty to keep the current image</p>

                        <input type="file" name="BookImg" id="BookImg" class="form-control d-none" accept="image/*"
                            onchange="displayFileName(this)">
                    </div>
                </div>

                <div class="form-footer">
                    <button type="submit" class="btn-update">
                        <i class="fas fa-save me-2"></i> Update Book
                    </button>

                    <a href="/" class="btn-outline">
                        <i class="fas fa-eye me-2"></i> View All Books
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function displayFileName(input) {
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            if (input.files.length > 0) {
                fileNameDisplay.textContent = `New file selected: ${input.files[0].name}`;
                fileNameDisplay.style.color = '#ff9a3c';
                fileNameDisplay.style.fontWeight = '600';
            } else {
                fileNameDisplay.textContent = 'No file selected - current image will be kept';
                fileNameDisplay.style.color = '#4a6cf7';
                fileNameDisplay.style.fontWeight = '500';
            }
        }

        // Add some interactivity to form inputs
        document.addEventListener('DOMContentLoaded', function () {
            const formInputs = document.querySelectorAll('.form-control');

            formInputs.forEach(input => {
                // Add focus effect
                input.addEventListener('focus', function () {
                    this.parentElement.classList.add('focused');
                });

                input.addEventListener('blur', function () {
                    if (this.value === '') {
                        this.parentElement.classList.remove('focused');
                    }
                });

                // Check if input has value on page load
                if (input.value !== '') {
                    input.parentElement.classList.add('focused');
                }
            });

            // Initialize file name display
            const fileInput = document.getElementById('BookImg');
            if (fileInput.files.length === 0) {
                document.getElementById('fileNameDisplay').textContent = 'No file selected - current image will be kept';
            }
        });
    </script>
</body>

</html>