    <%- include('../header') %>

<style>
    /* Premium Gradient Background matching your image */
    .page-wrapper {
        background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
        min-height: 100vh;
        padding-bottom: 50px;
    }

    /* Glassmorphism Card Style */
    .card {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-radius: 25px !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3) !important;
        overflow: hidden;
    }

    .page-title {
        color: #ffffff !important;
        font-weight: 800;
        letter-spacing: 1px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .card-title {
        font-weight: 700;
        color: #ffffff !important;
        margin-bottom: 25px;
        text-transform: uppercase;
        font-size: 1.2rem;
    }

    /* Modern Input Fields */
    .form-control, .custom-select {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        border-radius: 12px !important;
        color: white !important;
        padding: 12px 20px !important;
        transition: all 0.3s ease;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.15) !important;
        border-color: #ff416c !important;
        box-shadow: 0 0 15px rgba(255, 65, 108, 0.3) !important;
    }

    .control-label {
        color: rgba(255, 255, 255, 0.9) !important;
        font-weight: 500 !important;
    }

    /* Custom Radio & Checkbox Styling */
    .custom-control-label {
        color: white !important;
        cursor: pointer;
    }

    .custom-control-input:checked~.custom-control-label::before {
        background-color: #ff416c !important;
        border-color: #ff416c !important;
    }

    /* Gradient Submit Button like the 'Login' button in image */
    .submit-btn {
        background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
        border: none;
        border-radius: 15px;
        padding: 15px 40px;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.4s ease;
        box-shadow: 0 10px 20px rgba(255, 65, 108, 0.4);
        cursor: pointer;
    }

    .submit-btn:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 15px 25px rgba(255, 65, 108, 0.6);
        filter: brightness(1.1);
    }

    /* Breadcrumb styling */
    .breadcrumb-item a { color: rgba(255,255,255,0.7); }
    .breadcrumb-item.active { color: white; }
    .breadcrumb { background: transparent; }

    .form-section {
        background: transparent !important;
        padding: 30px;
    }

    /* Select2 dropdown color fix */
    option { background: #4e1a47; color: white; }
</style>

<div class="page-wrapper">
    <div class="page-breadcrumb">
        <div class="row">
            <div class="col-12 d-flex no-block align-items-center">
                <h4 class="page-title">Product info</h4>
                <div class="ml-auto text-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Create Products</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-9">
                <div class="card">
                    <form class="form-horizontal" action="/product/addProduct" method="post" enctype="multipart/form-data">
                        <div class="card-body form-section">
                            <h4 class="card-title text-center">✨ Products Details</h4>
                            <hr style="border-top: 1px solid rgba(255,255,255,0.1); margin-bottom: 30px;">
                            <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Title</label>
                                        <input type="text" class="form-control" name="product_name" placeholder="Enter Title Name">
                                    </div>
                                </div>
                           
                              <div class="li-row full-width">
                                        <div class="li-field">
                                            <label>📂 Select Category</label>
                                            <select id="category_id" name="category_id" required>
                                                <option value="">-- Select Category --</option>
                                                <% allCategory.forEach((category)=> { %>
                                                    <option value="<%= category._id %>">
                                                        <%= category.category_name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                        <div class="li-field">
                                            <label>📂 Select Sub Category</label>
                                            <select id="subcategory_id" name="subcategory_id" required>
                                                <option value="">-- Select Sub Category --</option>
                                                <% allSubCategory.forEach((sub)=> { %>
                                                    <option value="<%= sub._id %>">
                                                        <%= sub.subcategory_name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="li-row full-width">
                                        <div class="li-field">
                                            <label>📂 Select Extra Category</label>
                                            <select id="extraCategory_id" name="extraCategory_id" required>
                                                <option value="">-- Select Extra Category --</option>
                                                <% allExtraCategory.forEach((extra)=> { %>
                                                    <option value="<%= extra._id %>">
                                                        <%= extra.extracategory_name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                    </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Old Price</label>
                                        <input type="number" class="form-control" name="old_price" placeholder="Enter Old Price">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Price</label>
                                        <input type="number" class="form-control" name="new_price" placeholder="Enter New Price">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Stock</label>
                                        <input type="number" class="form-control" name="stock" placeholder="Enter Stock">
                                    </div>
                                </div>
                                
                            </div>

                            <div class="form-group mt-4">
                                <label class="control-label">Description</label>
                                <textarea class="form-control" name="description" rows="3" placeholder="Enter Description..."></textarea>
                            </div>

                            <div class="form-group mt-3">
                                <label class="control-label">Profile Image</label>
                                <input type="file" name="product_img" class="form-control" style="height: auto;">
                            </div>
                        </div>

                        <div class="text-center pb-5">
                            <button type="submit" class="submit-btn">
                                🚀 Create Product Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../footer') %>