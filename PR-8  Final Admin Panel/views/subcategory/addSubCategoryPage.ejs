<%- include('../header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    /* Premium Deep Gradient Background */
    .page-wrapper {
        background: linear-gradient(135deg, #2e1a47 0%, #7a1b5d 50%, #c31432 100%) !important;
        min-height: 100vh;
        padding-bottom: 50px;
        font-family: 'Poppins', sans-serif;
    }

    /* Enhanced Glassmorphism Card */
    .card {
        background: rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 30px !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4) !important;
        margin-top: 20px;
    }

    .page-title {
        color: #ffffff !important;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        text-shadow: 2px 4px 10px rgba(0,0,0,0.3);
    }

    .card-title {
        font-weight: 600;
        color: #ffffff !important;
        letter-spacing: 1px;
    }

    /* Modern Styled Inputs with Icons */
    .input-group-text {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        border-right: none !important;
        border-radius: 12px 0 0 12px !important;
        color: #ff416c !important;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        border-radius: 0 12px 12px 0 !important;
        color: white !important;
        padding: 12px 15px !important;
        transition: 0.3s;
    }

    /* File input specific fix */
    input[type="file"].form-control {
        border-radius: 12px !important;
        padding: 8px !important;
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.12) !important;
        border-color: #ff416c !important;
        box-shadow: 0 0 15px rgba(255, 65, 108, 0.4) !important;
        outline: none;
    }

    .control-label {
        color: rgba(255, 255, 255, 0.85) !important;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
    }

    /* Floating Submit Button */
    .submit-btn {
        background: linear-gradient(45deg, #ff416c, #ff4b2b) !important;
        border: none;
        border-radius: 50px;
        padding: 15px 50px;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255, 65, 108, 0.5);
        margin-top: 20px;
    }

    .submit-btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(255, 65, 108, 0.7);
        filter: brightness(1.2);
    }

    /* Breadcrumb styling */
    .breadcrumb-item a { color: rgba(255,255,255,0.6); text-decoration: none; }
    .breadcrumb-item.active { color: #ff416c; font-weight: bold; }
</style>

<div class="page-wrapper">
    <div class="page-breadcrumb">
        <div class="row p-4">
            <div class="col-12 d-flex no-block align-items-center">
                <h4 class="page-title">✨ Sub Add Category</h4>
                <div class="ml-auto text-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#"><i class="fa fa-home"></i> Home</a></li>
                            <li class="breadcrumb-item active">Sub Category</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="card">
                    <form class="form-horizontal" method="post" action="/subCategory/addSubCategory">
                        <div class="card-body p-5">
                            <h4 class="card-title text-center mb-4">Category Setup</h4>
                            
                            <div class="form-group mb-4">
                                <label class="control-label">Sub Category Name</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-tag"></i></span>
                                    </div>
                                    <input type="text" class="form-control" name="subcategory_name" placeholder="Enter Sub category Name" required>
                                </div>
                            </div>
                             <!-- Select Category -->
                                <div class="form-group row">
                                    <label for="fname"
                                        class="col-sm-3 text-right control-label col-form-label">Category</label>
                                    <div class="col-sm-9">
                                        <select class="form-control" name="category_id" required>
                                            <option value="">-- Select --</option>
                                            <% allCategory.map((category)=> { %>
                                                <option value="<%= category.id%>">
                                                    <%= category.category_name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>
                            

                            <div class="text-center">
                                <button type="submit" class="submit-btn w-100">
                                    🚀 Save Category
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../footer') %>